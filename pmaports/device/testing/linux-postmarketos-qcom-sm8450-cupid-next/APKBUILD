# Maintainer: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
# Experimental kernel for the Xiaomi 12 (cupid).
#
# Same recipe as linux-postmarketos-qcom-sm8450-cupid, but on the newer "next"
# branch of the sm8450-mainline fork (6.17.0-rc1, 2025-08-16). That rebase
# dropped the touchscreen node from the cupid devicetree and renamed the panel
# compatible; both are handled in the devicetree shipped here. The zeus audio
# backport (0012) is not carried: it only applies on top of the dropped
# speaker experiment patches.
#
# Nobody has reported booting this tree on cupid. Keep the 6.13 package as the
# fallback: pmbootstrap config kernel stable
_flavor="postmarketos-qcom-sm8450-cupid-next"
pkgname=linux-$_flavor
pkgver=6.17.0_rc1
pkgrel=0
pkgdesc="Mainline kernel fork for the Xiaomi 12 (cupid), 6.17-rc1 base (experimental)"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm8450-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="
	bison
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	openssl-dev
	pahole
	perl
	python3
	"

_repo="linux"
_config="config-$_flavor.$arch"
# sm8450-mainline/linux next, 2025-08-16, v6.17.0-rc1
_commit="a19585977c11fa662435b607cb9ff4ac7133092e"

source="
	$_repo-$_commit.tar.gz::https://github.com/sm8450-mainline/$_repo/archive/$_commit/$_repo-$_commit.tar.gz
	$_config
	sm8450-xiaomi-cupid.dts
	0002-fts-single-full-duplex-transfer-for-geni.patch
	0003-fts-palm-rejection-and-panel-follower.patch
	0004-pcie-qcom-retry-link-training-with-endpoint-reset.patch
	0005-ath11k-reset-the-firmware-when-wmi-stops-answering.patch
	0006-q6apm-poll-for-spf-readiness-like-the-downstream-driver.patch
	0007-pdr-ack-service-up-before-notifying-clients.patch
	0008-apr-install-the-gpr-callback-before-probing.patch
	0009-libbpf-const-correct-strstr-strchr-results.patch
"
builddir="$srcdir/$_repo-$_commit"

prepare() {
	default_prepare

	cp "$srcdir"/sm8450-xiaomi-cupid.dts \
		arch/arm64/boot/dts/qcom/sm8450-xiaomi-cupid.dts

	cp "$srcdir/$_config" .config
	make ARCH="$_carch" CC="${CC:-gcc}" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

