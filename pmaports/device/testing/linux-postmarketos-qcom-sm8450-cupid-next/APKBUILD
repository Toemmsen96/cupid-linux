# Maintainer: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
# Experimental kernel for the Xiaomi 12 (cupid).
#
# Same recipe as linux-postmarketos-qcom-sm8450-cupid, but on the newer "next"
# branch of the sm8450-mainline fork (6.17.0-rc1, 2025-08-16). That rebase
# dropped the touchscreen node from the cupid devicetree and renamed the panel
# compatible; both are handled in the devicetree shipped here.
#
# Carries the 6.13 package's fixes (0010-0020; the panel patches 0011/0014/
# 0018 are ported to 6.17's driver as one 0011, the IPA v5.1 backport is
# re-ported as 0012) plus what only this tree can take: SM8450 CAMSS from the
# Galaxy Tab S8+ port (0021, 0022, built on 6.17's CSID/VFE 680 support), the
# optional PM8008 interrupt for the camera PMIC (0023) and devicetree support
# for the OV13B10 ultra-wide sensor (0024).
#
# Nobody has reported booting this tree on cupid. Keep the 6.13 package as the
# fallback: pmbootstrap config kernel stable
_flavor="postmarketos-qcom-sm8450-cupid-next"
pkgname=linux-$_flavor
pkgver=6.17.0_rc1
pkgrel=7
pkgdesc="Mainline kernel fork for the Xiaomi 12 (cupid), 6.17-rc1 base (experimental)"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm8450-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="
	bison
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	openssl-dev
	pahole
	perl
	python3
	"

_repo="linux"
_config="config-$_flavor.$arch"
# sm8450-mainline/linux next, 2025-08-16, v6.17.0-rc1
_commit="a19585977c11fa662435b607cb9ff4ac7133092e"

source="
	$_repo-$_commit.tar.gz::https://github.com/sm8450-mainline/$_repo/archive/$_commit/$_repo-$_commit.tar.gz
	$_config
	sm8450-xiaomi-cupid.dts
	0002-fts-single-full-duplex-transfer-for-geni.patch
	0003-fts-palm-rejection-and-panel-follower.patch
	0004-pcie-qcom-retry-link-training-with-endpoint-reset.patch
	0005-ath11k-reset-the-firmware-when-wmi-stops-answering.patch
	0006-q6apm-poll-for-spf-readiness-like-the-downstream-driver.patch
	0007-pdr-ack-service-up-before-notifying-clients.patch
	0008-apr-install-the-gpr-callback-before-probing.patch
	0009-libbpf-const-correct-strstr-strchr-results.patch
	0010-battmgr-stop-requesting-properties-the-firmware-never-answers.patch
	0011-panel-l3-42-02-0a-brightness-refresh-rate-and-timing-tails.patch
	0012-ipa-add-ipa-v5.1-for-sm8450.patch
	0013-arm64-dts-sm8450-add-ipa-node.patch
	0015-msm-dsi-round-byte-clock-to-the-pll-rate.patch
	0016-ipa-backport-v5.x-gsi-fixes.patch
	0019-input-add-awinic-aw8697-haptics-driver.patch
	0020-battmgr-translate-xiaomi-battery-property-ids.patch
	0021-media-qcom-camss-add-sm8450-support.patch
	0022-clk-qcom-camcc-sm8450-park-rcgs-on-xo.patch
	0023-mfd-qcom-pm8008-make-the-interrupt-optional.patch
	0024-media-i2c-ov13b10-devicetree-support.patch
	0025-drm-msm-dpu-single-slice-dsc-and-plane-check.patch
"
builddir="$srcdir/$_repo-$_commit"

prepare() {
	default_prepare

	cp "$srcdir"/sm8450-xiaomi-cupid.dts \
		arch/arm64/boot/dts/qcom/sm8450-xiaomi-cupid.dts

	cp "$srcdir/$_config" .config
	make ARCH="$_carch" CC="${CC:-gcc}" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

