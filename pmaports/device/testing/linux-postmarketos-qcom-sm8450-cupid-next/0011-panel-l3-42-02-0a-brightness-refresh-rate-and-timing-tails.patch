panel: l3-42-02-0a: brightness while off, selectable refresh rate, stock timing tails

Port to 6.17 (multi-context DSI helpers) of the 6.13 patches 0011, 0014 and
0018 of linux-postmarketos-qcom-sm8450-cupid:

- keep the brightness while the panel is off and apply it on enable,
  always restore MIPI_DSI_MODE_LPM, drop the DCS 0x52 read-back that always
  failed (0011);
- refresh_rate module parameter, 60/90/120 Hz (default 120, like stock),
  with the stock per-rate commands; the mode clock follows (0014);
- the stock timing-switch tails for 60/120 Hz; 60 Hz ran at ~29 Hz without
  (0018).

--- a/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c	2026-11-16 12:54:22.505035979 +0100
+++ b/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c	2026-11-16 12:54:22.545478721 +0100
@@ -23,8 +23,25 @@
 	struct drm_dsc_config dsc;
 	struct regulator_bulk_data *supplies;
 	struct gpio_desc *reset_gpio;
+	/* DCS commands are only accepted between prepare and unprepare */
+	bool prepared;
 };
 
+/*
+ * The panel refreshes from its own RAM at the rate selected by DCS 0x2f
+ * (stock timing@0/1/2: 0x01 = 60 Hz, 0x02 = 120 Hz, 0x03 = 90 Hz). At 60 Hz
+ * the OLED's PWM dimming visibly flickers; stock HyperOS runs at 120 Hz.
+ * Only one mode is exposed; pick it at load time.
+ */
+static unsigned int refresh_rate = 120;
+module_param(refresh_rate, uint, 0444);
+MODULE_PARM_DESC(refresh_rate, "Panel refresh rate in Hz: 60, 90 or 120 (default 120)");
+
+static unsigned int l3_42_02_0a_dsc_rate(void)
+{
+	return (refresh_rate == 60 || refresh_rate == 90) ? refresh_rate : 120;
+}
+
 static const struct regulator_bulk_data l3_42_02_0a_dsc_supplies[] = {
 	{ .supply = "vddio" },
 	{ .supply = "vddd" },
@@ -63,8 +80,47 @@
