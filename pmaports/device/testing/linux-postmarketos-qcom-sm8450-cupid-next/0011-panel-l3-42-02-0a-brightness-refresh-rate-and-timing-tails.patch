+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0,
+					     0x55, 0xaa, 0x52, 0x08, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6f, 0x0a);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc0, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0,
