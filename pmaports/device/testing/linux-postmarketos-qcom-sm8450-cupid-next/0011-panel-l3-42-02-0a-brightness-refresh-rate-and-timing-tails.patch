+		/* without this tail the 60 Hz mode runs at ~29 Hz */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0,
+					     0x55, 0xaa, 0x52, 0x08, 0x02);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcc, 0x00);
+		break;
+	case 90:
