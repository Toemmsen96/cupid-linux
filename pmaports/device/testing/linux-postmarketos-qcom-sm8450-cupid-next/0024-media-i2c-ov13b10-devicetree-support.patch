media: i2c: ov13b10: devicetree support

The driver matched ACPI only. Add an "ovti,ov13b10" OF match and the
optional I/O (dovdd) and core (dvdd) supplies next to avdd, enabled in
datasheet order (DOVDD, AVDD, DVDD, then XVCLK, then XSHUTDN released).
For the Xiaomi 12 ultra-wide camera.

diff --git a/drivers/media/i2c/ov13b10.c b/drivers/media/i2c/ov13b10.c
index e85c7d33a..9ebea6ba0 100644
--- a/drivers/media/i2c/ov13b10.c
+++ b/drivers/media/i2c/ov13b10.c
@@ -707,6 +707,9 @@ struct ov13b10 {
 
 	struct clk *img_clk;
 	struct regulator *avdd;
+	/* devicetree boards: I/O and core supplies, optional */
+	struct regulator *dovdd;
+	struct regulator *dvdd;
 	struct gpio_desc *reset;
 
 	/* V4L2 Controls */
@@ -1196,10 +1199,14 @@ static int ov13b10_power_off(struct device *dev)
 
 	gpiod_set_value_cansleep(ov13b10->reset, 1);
 
+	clk_disable_unprepare(ov13b10->img_clk);
+
+	if (ov13b10->dvdd)
+		regulator_disable(ov13b10->dvdd);
 	if (ov13b10->avdd)
 		regulator_disable(ov13b10->avdd);
-
-	clk_disable_unprepare(ov13b10->img_clk);
+	if (ov13b10->dovdd)
+		regulator_disable(ov13b10->dovdd);
 
 	return 0;
 }
@@ -1210,26 +1217,54 @@ static int ov13b10_power_on(struct device *dev)
 	struct ov13b10 *ov13b10 = to_ov13b10(sd);
 	int ret;
 
-	ret = clk_prepare_enable(ov13b10->img_clk);
-	if (ret < 0) {
-		dev_err(dev, "failed to enable imaging clock: %d", ret);
-		return ret;
+	/* rails first (I/O, analog, core), then the clock, like the datasheet */
+	if (ov13b10->dovdd) {
+		ret = regulator_enable(ov13b10->dovdd);
+		if (ret < 0) {
+			dev_err(dev, "failed to enable dovdd: %d", ret);
+			return ret;
+		}
 	}
 
 	if (ov13b10->avdd) {
 		ret = regulator_enable(ov13b10->avdd);
 		if (ret < 0) {
 			dev_err(dev, "failed to enable avdd: %d", ret);
-			clk_disable_unprepare(ov13b10->img_clk);
-			return ret;
+			goto err_dovdd;
 		}
 	}
 
+	if (ov13b10->dvdd) {
+		ret = regulator_enable(ov13b10->dvdd);
+		if (ret < 0) {
+			dev_err(dev, "failed to enable dvdd: %d", ret);
+			goto err_avdd;
+		}
+	}
+
+	ret = clk_prepare_enable(ov13b10->img_clk);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable imaging clock: %d", ret);
+		goto err_dvdd;
+	}
+	usleep_range(1000, 1500);
+
 	gpiod_set_value_cansleep(ov13b10->reset, 0);
 	/* 5ms to wait ready after XSHUTDN assert */
 	usleep_range(5000, 5500);
 
 	return 0;
+
+err_dvdd:
+	if (ov13b10->dvdd)
+		regulator_disable(ov13b10->dvdd);
+err_avdd:
+	if (ov13b10->avdd)
+		regulator_disable(ov13b10->avdd);
+err_dovdd:
+	if (ov13b10->dovdd)
+		regulator_disable(ov13b10->dovdd);
+	return ret;
 }
 
 static int ov13b10_start_streaming(struct ov13b10 *ov13b)
@@ -1499,6 +1534,24 @@ static int ov13b10_get_pm_resources(struct device *dev)
 					     "failed to get avdd regulator\n");
 	}
 
+	ov13b->dovdd = devm_regulator_get_optional(dev, "dovdd");
+	if (IS_ERR(ov13b->dovdd)) {
+		ret = PTR_ERR(ov13b->dovdd);
+		ov13b->dovdd = NULL;
+		if (ret != -ENODEV)
+			return dev_err_probe(dev, ret,
+					     "failed to get dovdd regulator\n");
+	}
+
+	ov13b->dvdd = devm_regulator_get_optional(dev, "dvdd");
+	if (IS_ERR(ov13b->dvdd)) {
+		ret = PTR_ERR(ov13b->dvdd);
+		ov13b->dvdd = NULL;
+		if (ret != -ENODEV)
+			return dev_err_probe(dev, ret,
+					     "failed to get dvdd regulator\n");
+	}
+
 	return 0;
 }
 
@@ -1709,11 +1762,18 @@ static const struct acpi_device_id ov13b10_acpi_ids[] = {
 MODULE_DEVICE_TABLE(acpi, ov13b10_acpi_ids);
 #endif
 
+static const struct of_device_id ov13b10_of_match[] = {
+	{ .compatible = "ovti,ov13b10" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov13b10_of_match);
+
 static struct i2c_driver ov13b10_i2c_driver = {
 	.driver = {
 		.name = "ov13b10",
 		.pm = pm_ptr(&ov13b10_pm_ops),
 		.acpi_match_table = ACPI_PTR(ov13b10_acpi_ids),
+		.of_match_table = ov13b10_of_match,
 	},
 	.probe = ov13b10_probe,
 	.remove = ov13b10_remove,
