PCI: qcom: honour #iommu-cells when parsing iommu-map for the BDF-to-SID table

qcom_pcie_config_sid_1_9_0() read iommu-map as fixed 4-cell entries
<bdf phandle sid len>. sm8450.dtsi (and others) now use 5-cell entries
with the SID mask cell (#iommu-cells = <2>), so every entry after the
first was misparsed: the WCN6855 at BDF 0x100 got no BDF-to-SID entry
(the table held one garbage entry). Its DMA still worked through the
Root Port's stream (same IOMMU group), but its MSIs reached the GIC ITS
with the Root Port's device ID and were dropped: ath11k's firmware
download completed on the chip (BHI status SUCCESS, SBL running) while
the host never saw an interrupt ("MHI did not load image over BHI").

Read #iommu-cells from the SMMU node and walk the map with that stride.

diff --git a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
index 89a476c37..04efbc4e1 100644
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -1143,18 +1143,21 @@ static void qcom_pcie_deinit_2_7_0(struct qcom_pcie *pcie)
 
 static int qcom_pcie_config_sid_1_9_0(struct qcom_pcie *pcie)
 {
-	/* iommu map structure */
-	struct {
-		u32 bdf;
-		u32 phandle;
-		u32 smmu_sid;
-		u32 smmu_sid_len;
-	} *map;
+	/*
+	 * iommu-map entries: <bdf phandle sid... len>, with as many SID cells
+	 * as the SMMU's #iommu-cells (2 on sm8450 since the SID mask cell
+	 * was added). Reading fixed 4-cell entries misparsed every entry
+	 * after the first: the endpoint got no BDF-to-SID entry, its MSIs
+	 * reached the ITS with the Root Port's device ID and were dropped.
+	 */
 	void __iomem *bdf_to_sid_base = pcie->parf + PARF_BDF_TO_SID_TABLE_N;
 	struct device *dev = pcie->pci->dev;
 	u8 qcom_pcie_crc8_table[CRC8_TABLE_SIZE];
-	int i, nr_map, size = 0;
+	int i, nr_map, nr_cells, stride, size = 0;
+	struct device_node *smmu;
+	u32 iommu_cells = 1;
 	u32 smmu_sid_base;
+	u32 *map;
 	u32 val;
 
 	of_get_property(dev->of_node, "iommu-map", &size);
@@ -1166,14 +1169,22 @@ static int qcom_pcie_config_sid_1_9_0(struct qcom_pcie *pcie)
 	val &= ~BDF_TO_SID_BYPASS;
 	writel(val, pcie->parf + PARF_BDF_TO_SID_CFG);
 
-	map = kzalloc(size, GFP_KERNEL);
+	nr_cells = size / sizeof(u32);
+	map = kcalloc(nr_cells, sizeof(u32), GFP_KERNEL);
 	if (!map)
 		return -ENOMEM;
 
-	of_property_read_u32_array(dev->of_node, "iommu-map", (u32 *)map,
-				   size / sizeof(u32));
+	of_property_read_u32_array(dev->of_node, "iommu-map", map, nr_cells);
 
-	nr_map = size / (sizeof(*map));
+	if (nr_cells >= 2) {
+		smmu = of_find_node_by_phandle(map[1]);
+		if (smmu) {
+			of_property_read_u32(smmu, "#iommu-cells", &iommu_cells);
+			of_node_put(smmu);
+		}
+	}
+	stride = 3 + iommu_cells;
+	nr_map = nr_cells / stride;
 
 	crc8_populate_msb(qcom_pcie_crc8_table, QCOM_PCIE_CRC8_POLYNOMIAL);
 
@@ -1181,11 +1192,13 @@ static int qcom_pcie_config_sid_1_9_0(struct qcom_pcie *pcie)
 	memset_io(bdf_to_sid_base, 0, CRC8_TABLE_SIZE * sizeof(u32));
 
 	/* Extract the SMMU SID base from the first entry of iommu-map */
-	smmu_sid_base = map[0].smmu_sid;
+	smmu_sid_base = map[2];
 
 	/* Look for an available entry to hold the mapping */
 	for (i = 0; i < nr_map; i++) {
-		__be16 bdf_be = cpu_to_be16(map[i].bdf);
+		u32 bdf = map[i * stride];
+		u32 smmu_sid = map[i * stride + 2];
+		__be16 bdf_be = cpu_to_be16(bdf);
 		u32 val;
 		u8 hash;
 
@@ -1208,7 +1221,7 @@ static int qcom_pcie_config_sid_1_9_0(struct qcom_pcie *pcie)
 		}
 
 		/* BDF [31:16] | SID [15:8] | NEXT [7:0] */
-		val = map[i].bdf << 16 | (map[i].smmu_sid - smmu_sid_base) << 8 | 0;
+		val = bdf << 16 | (smmu_sid - smmu_sid_base) << 8 | 0;
 		writel(val, bdf_to_sid_base + hash * sizeof(u32));
 	}
 
