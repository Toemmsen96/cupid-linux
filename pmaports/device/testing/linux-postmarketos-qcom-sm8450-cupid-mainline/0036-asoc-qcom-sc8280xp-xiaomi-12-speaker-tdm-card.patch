From 62a7cb8a814bbeabfaa668ef146f963bc34a15ef Mon Sep 17 00:00:00 2001
From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:59:20 +0100
Subject: [PATCH] ASoC: qcom: sc8280xp: add the Xiaomi 12 speaker TDM card

The Xiaomi 12 (cupid) has two CS35L41 speaker amplifiers on the tertiary
TDM interface. Stock Android runs it at 96 kHz with 24-bit samples in four
32-bit slots, short frame sync, SoC clock provider, and holds an LPASS
core vote while it is active ("qcom,mi2s-tdm-is-hw-vote-needed").

Add a "xiaomi,cupid-sndcard" card with the SM8450 card settings (the
"sm8450" driver name keeps the qcom/sm8450 topology and UCM paths) plus
board fields:

- the TDM backend rate, sample format and channel count, applied in the
  backend fixup;
- a TDM codec DAI format (DSP A for the CS35L41) when it differs from the
  I2S one;
- the bit clock as component and DAI sysclk of the TDM codecs, for the
  CS35L41 PLL, which runs from SCLK;
- the "tdm-vote" (LPASS MACRO) and optional "tdm-dcodec-vote" clocks,
  held from backend startup to shutdown for every backend, and the
  optional "tdm-bclk" clock for TDM backends. On 7.3 the DSP also refuses
  to open the headphone codec DMA graph ("DSP returned error[1001000]")
  unless these votes are held, which the runtime PM LPASS macros do not
  guarantee at prepare() time.

The clock handling follows dianqk's Xiaomi Poco F5 (marble) speaker card
in github.com/dianqk/nixos-android-devices (0054, 0064), which needs the
same votes on the same ADSP generation: since 7.3 the LPASS macros only
hold the MACRO/DCODEC votes while runtime active, and the bit clock has to
run before the DSP graph opens.

Signed-off-by: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
---
 sound/soc/qcom/sc8280xp.c | 210 ++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 205 insertions(+), 5 deletions(-)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 4d48e1012..7d6c4ab47 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -2,6 +2,7 @@
 // Copyright (c) 2022, Linaro Limited
 
 #include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <sound/soc.h>
@@ -71,6 +72,24 @@ struct qcom_snd_soc_common {
 	bool mi2s_mclk_enable;
 	bool mi2s_bclk_enable;
 	bool wcd_jack;
+	/* TDM backend rate, format and channels; 0 keeps 48 kHz S16_LE stereo */
+	unsigned int tdm_rate;
+	snd_pcm_format_t tdm_format;
+	unsigned int tdm_channels;
+	/* TDM codec DAI format, if it differs from codec_dai_fmt */
+	unsigned int tdm_codec_dai_fmt;
+	/*
+	 * TDM codecs that run their PLL from the bit clock (CS35L41): pass
+	 * the bit clock rate as component and DAI sysclk, clock ID 0.
+	 */
+	bool tdm_codec_sclk;
+	/*
+	 * Boards whose backends need the LPASS core held: the "tdm-vote"
+	 * (MACRO) clock and the optional "tdm-dcodec-vote" clock for every
+	 * backend session, the optional "tdm-bclk" clock for TDM ones, from
+	 * backend startup to shutdown.
+	 */
+	bool tdm_hw_vote;
 	int (*snd_prepare)(struct snd_pcm_substream *substream);
 };
 
@@ -80,6 +99,9 @@ struct sc8280xp_snd_data {
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
 	const struct qcom_snd_soc_common *priv;
+	struct clk *tdm_vote;
+	struct clk *tdm_dcodec_vote;
+	struct clk *tdm_bclk;
 	bool jack_setup;
 };
 
@@ -130,10 +152,12 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 	if (ret && ret != -ENOTSUPP)
 		return ret;
 
-	if (data->priv->codec_dai_fmt) {
+	if (data->priv->tdm_codec_dai_fmt || data->priv->codec_dai_fmt) {
+		unsigned int fmt = data->priv->tdm_codec_dai_fmt ?:
+				   data->priv->codec_dai_fmt;
+
 		for_each_rtd_codec_dais(rtd, i, codec_dai) {
-			ret = snd_soc_dai_set_fmt(codec_dai,
-						  data->priv->codec_dai_fmt);
+			ret = snd_soc_dai_set_fmt(codec_dai, fmt);
 			if (ret && ret != -ENOTSUPP)
 				return ret;
 		}
@@ -169,6 +193,21 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 		}
 	}
 
+	if (data->priv->tdm_codec_sclk) {
+		for_each_rtd_codec_dais(rtd, i, codec_dai) {
+			ret = snd_soc_component_set_sysclk(codec_dai->component, 0, 0,
+							   bclk_freq, SND_SOC_CLOCK_IN);
+			if (!ret)
+				ret = snd_soc_dai_set_sysclk(codec_dai, 0, bclk_freq,
+							     SND_SOC_CLOCK_IN);
+			if (ret && ret != -ENOTSUPP) {
+				dev_err(rtd->dev, "%s: failed to set the %u Hz bit clock on %s: %d\n",
+					__func__, bclk_freq, codec_dai->name, ret);
+				return ret;
+			}
+		}
+	}
+
 	return 0;
 }
 
@@ -218,6 +257,7 @@ static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
 static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				     struct snd_pcm_hw_params *params)
 {
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_interval *rate = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_RATE);
@@ -236,6 +276,16 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	case TX_CODEC_DMA_TX_3:
 		channels->min = 1;
 		break;
+	case PRIMARY_TDM_RX_0 ... QUINARY_TDM_TX_7:
+		if (data->priv->tdm_rate)
+			rate->min = rate->max = data->priv->tdm_rate;
+		if (data->priv->tdm_format) {
+			snd_mask_none(fmt);
+			snd_mask_set_format(fmt, data->priv->tdm_format);
+		}
+		if (data->priv->tdm_channels)
+			channels->min = channels->max = data->priv->tdm_channels;
+		break;
 	default:
 		break;
 	}
@@ -368,9 +418,110 @@ static int sc8280xp_snd_hw_free(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_hw_free(substream, &data->stream_prepared[cpu_dai->id]);
 }
 
+static bool sc8280xp_is_tdm(struct snd_soc_dai *cpu_dai)
+{
+	return cpu_dai->id >= PRIMARY_TDM_RX_0 && cpu_dai->id <= QUINARY_TDM_TX_7;
+}
+
+/*
+ * Card-held TDM bit clock: set to the backend rate times the DAI-node slot
+ * layout and running from backend startup, before the DSP graph is opened,
+ * until shutdown, before the graph is torn down.
+ */
+static int sc8280xp_tdm_bclk_enable(struct snd_soc_pcm_runtime *rtd)
+{
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	struct qcom_snd_tdm_slot_cfg cpu_cfg;
+	struct qcom_snd_tdm_slot_cfg codec_cfg;
+	int ret;
+
+	if (!data->tdm_bclk)
+		return 0;
+
+	ret = qcom_snd_get_dai_tdm_slots(rtd, &cpu_cfg, &codec_cfg);
+	if (ret)
+		return ret;
+
+	if (!data->priv->tdm_rate || !cpu_cfg.slots || !cpu_cfg.slot_width)
+		return -EINVAL;
+
+	ret = clk_set_rate(data->tdm_bclk,
+			   data->priv->tdm_rate * cpu_cfg.slots * cpu_cfg.slot_width);
+	if (ret)
+		return ret;
+
+	return clk_prepare_enable(data->tdm_bclk);
+}
+
+static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	bool votes = data->tdm_vote;
+	bool tdm = sc8280xp_is_tdm(cpu_dai) && votes;
+	int ret;
+
+	/*
+	 * The DSP only opens a codec DMA or TDM graph while the LPASS MACRO
+	 * and DCODEC blocks are voted. Since the LPASS macros hold their
+	 * votes only while runtime active, the graph open in prepare() can
+	 * come before any macro resumes ("DSP returned error[1001000]").
+	 */
+	if (votes) {
+		ret = clk_prepare_enable(data->tdm_vote);
+		if (ret)
+			return ret;
+
+		ret = clk_prepare_enable(data->tdm_dcodec_vote);
+		if (ret)
+			goto err_vote;
+	}
+
+	if (tdm) {
+		ret = sc8280xp_tdm_bclk_enable(rtd);
+		if (ret) {
+			dev_err(rtd->dev, "failed to enable the TDM bit clock: %d\n", ret);
+			goto err_dcodec;
+		}
+	}
+
+	ret = qcom_snd_sdw_startup(substream);
+	if (ret && votes)
+		goto err_bclk;
+
+	return ret;
+
+err_bclk:
+	if (tdm)
+		clk_disable_unprepare(data->tdm_bclk);
+err_dcodec:
+	clk_disable_unprepare(data->tdm_dcodec_vote);
+err_vote:
+	clk_disable_unprepare(data->tdm_vote);
+	return ret;
+}
+
+static void sc8280xp_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+
+	qcom_snd_sdw_shutdown(substream);
+
+	if (!data->tdm_vote)
+		return;
+
+	if (sc8280xp_is_tdm(cpu_dai))
+		clk_disable_unprepare(data->tdm_bclk);
+	clk_disable_unprepare(data->tdm_dcodec_vote);
+	clk_disable_unprepare(data->tdm_vote);
+}
+
 static const struct snd_soc_ops sc8280xp_be_ops = {
-	.startup = qcom_snd_sdw_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.startup = sc8280xp_snd_startup,
+	.shutdown = sc8280xp_snd_shutdown,
 	.hw_params = sc8280xp_snd_hw_params,
 	.hw_free = sc8280xp_snd_hw_free,
 	.prepare = sc8280xp_snd_prepare,
@@ -410,6 +561,23 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 	if (!data->priv)
 		return -ENODEV;
 
+	if (data->priv->tdm_hw_vote) {
+		data->tdm_vote = devm_clk_get(dev, "tdm-vote");
+		if (IS_ERR(data->tdm_vote))
+			return dev_err_probe(dev, PTR_ERR(data->tdm_vote),
+					     "failed to get tdm-vote clock\n");
+
+		data->tdm_dcodec_vote = devm_clk_get_optional(dev, "tdm-dcodec-vote");
+		if (IS_ERR(data->tdm_dcodec_vote))
+			return dev_err_probe(dev, PTR_ERR(data->tdm_dcodec_vote),
+					     "failed to get tdm-dcodec-vote clock\n");
+
+		data->tdm_bclk = devm_clk_get_optional(dev, "tdm-bclk");
+		if (IS_ERR(data->tdm_bclk))
+			return dev_err_probe(dev, PTR_ERR(data->tdm_bclk),
+					     "failed to get tdm-bclk clock\n");
+	}
+
 	card->owner = THIS_MODULE;
 	card->dev = dev;
 	dev_set_drvdata(dev, card);
@@ -518,6 +686,37 @@ static const struct qcom_snd_soc_common sm8450_priv_data = {
 			 SND_SOC_DAIFMT_I2S,
 };
 
+/*
+ * Xiaomi 12 (cupid): two CS35L41 speaker amplifiers on the tertiary TDM
+ * interface, run like stock at 96 kHz with 24-bit samples in four 32-bit
+ * slots (top amplifier slot 0, bottom slot 1), short frame sync with a
+ * one bit delay (DSP A), SoC clock provider. The amplifiers run their PLL
+ * from the bit clock. The interface needs the LPASS core votes of stock
+ * "qcom,mi2s-tdm-is-hw-vote-needed"; on this kernel the headphone codec DMA
+ * graph needs them too. The SM8450 driver name keeps the qcom/sm8450
+ * topology and UCM directories.
+ */
+static const struct qcom_snd_soc_common xiaomi_cupid_priv_data = {
+	.driver_name = "sm8450",
+	.dapm_widgets = sc8280xp_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(sc8280xp_dapm_widgets),
+	.wcd_jack = true,
+	.mi2s_mclk_enable = true,
+	.mi2s_bclk_enable = true,
+	.codec_dai_fmt = SND_SOC_DAIFMT_BC_FC |
+			 SND_SOC_DAIFMT_NB_NF |
+			 SND_SOC_DAIFMT_I2S,
+	.tdm_rate = 96000,
+	/* Stock: 24-bit samples in 32-bit slots; S32 overflowed in the DSP. */
+	.tdm_format = SNDRV_PCM_FORMAT_S24_LE,
+	.tdm_channels = 2,
+	.tdm_codec_dai_fmt = SND_SOC_DAIFMT_BC_FC |
+			     SND_SOC_DAIFMT_NB_NF |
+			     SND_SOC_DAIFMT_DSP_A,
+	.tdm_codec_sclk = true,
+	.tdm_hw_vote = true,
+};
+
 static const struct qcom_snd_soc_common sm8475_priv_data = {
 	.driver_name = "sm8475",
 	.dapm_widgets = sc8280xp_dapm_widgets,
@@ -576,6 +775,7 @@ static const struct of_device_id snd_sc8280xp_dt_match[] = {
 	{ .compatible = "qcom,sm8550-sndcard", .data = &sm8550_priv_data },
 	{ .compatible = "qcom,sm8650-sndcard", .data = &sm8650_priv_data },
 	{ .compatible = "qcom,sm8750-sndcard", .data = &sm8750_priv_data },
+	{ .compatible = "xiaomi,cupid-sndcard", .data = &xiaomi_cupid_priv_data },
 	{}
 };
 
