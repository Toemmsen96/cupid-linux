From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Subject: [PATCH] soc: qcom: apr: GPR send that waits for buffer space

gpr_send_pkt() uses rpmsg_trysend(), which fails with -EBUSY when the
remote has no receive buffer (glink intent) large enough. The ADSP on
SM8450 keeps 4 KiB intents, so any command over about 4 KiB fails, e.g.
the VCPM calibration tables of the voice call graphs (up to 16 KiB).

gpr_send_pkt_sleep() uses rpmsg_send() instead: glink then requests an
intent of the right size from the remote and fragments the packet. It
may sleep, so the existing callers, some of them atomic, keep
gpr_send_pkt(). The raw APM debugfs interface (0040) uses the new one.
---
--- a/drivers/soc/qcom/apr.c
+++ b/drivers/soc/qcom/apr.c
@@ -146,6 +146,30 @@
 }
 EXPORT_SYMBOL_GPL(gpr_send_pkt);
 
+/**
+ * gpr_send_pkt_sleep() - send a GPR packet, waiting for buffer space
+ * @gdev: GPR device
+ * @pkt: packet
+ *
+ * gpr_send_pkt() fails with -EBUSY when the remote has no receive buffer
+ * (glink intent) large enough for the packet, e.g. calibration tables over
+ * 4 KiB on the ADSP. This variant may sleep: glink then asks the remote for
+ * a buffer of the right size and splits the packet into fragments.
+ *
+ * Return: the packet size on success, a negative error otherwise.
+ */
+int gpr_send_pkt_sleep(struct apr_device *gdev, const struct gpr_pkt *pkt)
+{
+	struct packet_router *pr = gdev->svc.pr;
+	int ret;
+
+	might_sleep();
+	ret = rpmsg_send(pr->ch, (void *)pkt, pkt->hdr.pkt_size);
+
+	return ret ? ret : pkt->hdr.pkt_size;
+}
+EXPORT_SYMBOL_GPL(gpr_send_pkt_sleep);
+
 int gpr_send_port_pkt(gpr_port_t *port, const struct gpr_pkt *pkt)
 {
 	return pkt_router_send_svc_pkt(port, pkt);
--- a/include/linux/soc/qcom/apr.h
+++ b/include/linux/soc/qcom/apr.h
@@ -193,5 +193,6 @@
 void gpr_free_port(gpr_port_t *port);
 int gpr_send_port_pkt(gpr_port_t *port, const struct gpr_pkt *pkt);
 int gpr_send_pkt(gpr_device_t *gdev, const struct gpr_pkt *pkt);
+int gpr_send_pkt_sleep(gpr_device_t *gdev, const struct gpr_pkt *pkt);
 
 #endif /* __QCOM_APR_H_ */
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -940,7 +940,8 @@
 	apm->raw_done = false;
 	apm->raw_rsp_len = 0;
 	apm->raw_rsp_opcode = 0;
-	ret = gpr_send_pkt(apm->gdev, pkt);
+	/* may be large (calibration tables): let glink get a big buffer */
+	ret = gpr_send_pkt_sleep(apm->gdev, pkt);
 	if (ret >= 0) {
 		if (!wait_event_timeout(apm->raw_wait, apm->raw_done, 5 * HZ))
 			ret = -ETIMEDOUT;
