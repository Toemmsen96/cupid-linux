From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Subject: [PATCH] net: qrtr: route between remote nodes

On Qualcomm phones the remote processors (modem, ADSP, ...) each have a
QRTR link to the application processor only, which routes between them.
The SM8450 modem reaches the ADSP's voice call manager (GPR over QRTR)
that way. Mainline delivers every received data packet to a local port
and announces only local services, so traffic between two remote nodes
is lost and they never learn about each other's services. Downstream
kernels forward it (qrtr_fwd_pkt, msm-4.14 and later).

af_qrtr: data and resume-tx packets addressed to another node are sent on
to that node's endpoint, from a worker since transmitting takes the
endpoint mutex and packets arrive in atomic context.

ns: services of a remote node are announced to the other remote nodes,
their removal too, and a node saying hello gets the services of all
other nodes, not just the local ones.

Untested on hardware yet.
---
--- a/net/qrtr/af_qrtr.c
+++ b/net/qrtr/af_qrtr.c
@@ -441,6 +441,68 @@
 	spin_unlock_irqrestore(&qrtr_nodes_lock, flags);
 }
 
+/*
+ * Packets between two remote nodes (e.g. modem and ADSP) pass through this
+ * router: the remote processors only have a link to the application
+ * processor. Received in atomic context, they are sent on from a worker
+ * because transmitting takes the endpoint mutex.
+ */
+static struct sk_buff_head qrtr_fwd_queue;
+
+static void qrtr_fwd_work_fn(struct work_struct *work)
+{
+	struct qrtr_hdr_v1 *hdr;
+	struct qrtr_node *node;
+	struct sk_buff *skb;
+	struct qrtr_cb *cb;
+	size_t len;
+	int rc;
+
+	while ((skb = skb_dequeue(&qrtr_fwd_queue))) {
+		cb = (struct qrtr_cb *)skb->cb;
+		node = qrtr_node_lookup(cb->dst_node);
+		if (!node || cb->dst_node == cb->src_node) {
+			pr_debug("qrtr: no route from %u to %u\n",
+				 cb->src_node, cb->dst_node);
+			qrtr_node_release(node);
+			kfree_skb(skb);
+			continue;
+		}
+
+		len = skb->len;
+		if (skb_cow_head(skb, sizeof(*hdr))) {
+			qrtr_node_release(node);
+			kfree_skb(skb);
+			continue;
+		}
+		hdr = skb_push(skb, sizeof(*hdr));
+		hdr->version = cpu_to_le32(QRTR_PROTO_VER_1);
+		hdr->type = cpu_to_le32(cb->type);
+		hdr->src_node_id = cpu_to_le32(cb->src_node);
+		hdr->src_port_id = cpu_to_le32(cb->src_port);
+		hdr->confirm_rx = cpu_to_le32(cb->confirm_rx);
+		hdr->size = cpu_to_le32(len);
+		hdr->dst_node_id = cpu_to_le32(cb->dst_node);
+		hdr->dst_port_id = cpu_to_le32(cb->dst_port);
+
+		rc = skb_put_padto(skb, ALIGN(len, 4) + sizeof(*hdr));
+		if (!rc) {
+			mutex_lock(&node->ep_lock);
+			if (node->ep)
+				rc = node->ep->xmit(node->ep, skb);
+			else
+				kfree_skb(skb);
+			mutex_unlock(&node->ep_lock);
+		}
+		pr_debug("qrtr: forwarded %u:%u -> %u:%u type %u len %zu: %d\n",
+			 cb->src_node, cb->src_port, cb->dst_node, cb->dst_port,
+			 cb->type, len, rc);
+		qrtr_node_release(node);
+	}
+}
+
+static DECLARE_WORK(qrtr_fwd_work, qrtr_fwd_work_fn);
+
 /**
  * qrtr_endpoint_post() - post incoming data
  * @ep: endpoint handle
@@ -541,6 +603,13 @@
 		qrtr_node_assign(node, le32_to_cpu(pkt->server.node));
 	}
 
+	if ((cb->type == QRTR_TYPE_DATA || cb->type == QRTR_TYPE_RESUME_TX) &&
+	    cb->dst_node != qrtr_local_nid && cb->dst_node != QRTR_NODE_BCAST) {
+		skb_queue_tail(&qrtr_fwd_queue, skb);
+		schedule_work(&qrtr_fwd_work);
+		return 0;
+	}
+
 	if (cb->type == QRTR_TYPE_RESUME_TX) {
 		qrtr_tx_resume(node, skb);
 	} else {
@@ -1373,6 +1442,8 @@
 {
 	int rc;
 
+	skb_queue_head_init(&qrtr_fwd_queue);
+
 	rc = proto_register(&qrtr_proto, 1);
 	if (rc)
 		return rc;
@@ -1398,6 +1469,8 @@
 static void __exit qrtr_proto_fini(void)
 {
 	qrtr_ns_remove();
+	cancel_work_sync(&qrtr_fwd_work);
+	skb_queue_purge(&qrtr_fwd_queue);
 	sock_unregister(qrtr_family.family);
 	proto_unregister(&qrtr_proto);
 }
--- a/net/qrtr/ns.c
+++ b/net/qrtr/ns.c
@@ -183,6 +183,30 @@
 	return;
 }
 
+/*
+ * The remote processors reach each other only through this node, and they
+ * learn about each other's services from it: tell every other remote node
+ * about a service of a remote node (forwarding in af_qrtr.c carries the
+ * traffic).
+ */
+static void relay_remote_server(struct qrtr_server *srv, bool new)
+{
+	struct sockaddr_qrtr sq = { AF_QIPCRTR, 0, QRTR_PORT_CTRL };
+	struct qrtr_node *node;
+	unsigned long index;
+
+	xa_for_each(&nodes, index, node) {
+		if (node->id == qrtr_ns.local_node || node->id == srv->node)
+			continue;
+
+		sq.sq_node = node->id;
+		if (new)
+			service_announce_new(&sq, srv);
+		else
+			service_announce_del(&sq, srv);
+	}
+}
+
 static void lookup_notify(struct sockaddr_qrtr *to, struct qrtr_server *srv,
 			  bool new)
 {
@@ -217,22 +241,23 @@
 {
 	struct qrtr_server *srv;
 	struct qrtr_node *node;
-	unsigned long index;
+	unsigned long nindex, index;
 	int ret;
 
-	node = node_get(qrtr_ns.local_node);
-	if (!node)
-		return 0;
-
-	/* Announce the list of servers registered in this node */
-	xa_for_each(&node->servers, index, srv) {
-		ret = service_announce_new(sq, srv);
-		if (ret < 0) {
-			if (ret == -ENODEV)
-				continue;
+	/* Announce the servers of this node and of the other remote nodes */
+	xa_for_each(&nodes, nindex, node) {
+		if (node->id == sq->sq_node)
+			continue;
 
-			pr_err("failed to announce new service\n");
-			return ret;
+		xa_for_each(&node->servers, index, srv) {
+			ret = service_announce_new(sq, srv);
+			if (ret < 0) {
+				if (ret == -ENODEV)
+					continue;
+
+				pr_err("failed to announce new service\n");
+				return ret;
+			}
 		}
 	}
 	return 0;
@@ -306,9 +331,11 @@
 
 	xa_erase(&node->servers, port);
 
-	/* Broadcast the removal of local servers */
+	/* Broadcast the removal of local servers, relay remote ones */
 	if (srv->node == qrtr_ns.local_node && bcast)
 		service_announce_del(&qrtr_ns.bcast_sq, srv);
+	else if (bcast)
+		relay_remote_server(srv, false);
 
 	/* Announce the service's disappearance to observers */
 	list_for_each(li, &qrtr_ns.lookups) {
@@ -492,6 +519,8 @@
 			pr_err("failed to announce new service\n");
 			return ret;
 		}
+	} else {
+		relay_remote_server(srv, true);
 	}
 
 	/* Notify any potential lookups about the new server */
