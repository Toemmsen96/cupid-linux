# Maintainer: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
# Mainline kernel for the Xiaomi 12 (cupid): Linux 7.3 stable from kernel.org.
#
# The sm8450-mainline fork (stable/next packages) is not needed any more for
# most of the SoC: 7.3 has the DPU quad-pipe work, the DSI byte clock rounding,
# the IPA v5.x GSI fixes and the CSID/VFE 680 blocks CAMSS builds on. What
# only the fork had is carried here as patches (fork-*): the generated panel
# driver for l3-42-02-0a, the ST FTS SPI touch driver from downstream, and
# two small sm8450.dtsi changes. The cupid devicetree is the next package's,
# adapted to mainline's sm8450.dtsi (flattened USB node, three reserved
# regions mainline no longer has).
#
# Our patches keep the numbers of the 6.13/6.17 packages. Dropped because 7.3
# has them or no longer needs them: 0009 (libbpf const, fixed upstream), 0015
# (DSI rounding), 0016 (GSI fixes). 0004 (PCIe link-training retry) is left
# out on purpose: the qcom PCIe driver and pwrctrl were reworked upstream;
# re-port it only if WiFi does not come up.
#
# First boot 2026-11-16 (r0): display (no more sporadic corruption), touch,
# battery, modem, IPA, Bluetooth, audio card, camera stack work. WiFi does
# not: ath11k's firmware load fails ("MHI did not load image over BHI",
# -EIO after the 20 s timeout) although the PCIe link trains and the
# WCN6855 power sequence (incl. the XO clock handshake added in r1) runs.
# Keep stable/next as fallbacks: pmbootstrap config kernel next
_flavor="postmarketos-qcom-sm8450-cupid-mainline"
pkgname=linux-$_flavor
pkgver=7.3.4
pkgrel=2
pkgdesc="Linux 7.3 for the Xiaomi 12 (cupid) with the cupid patches (experimental)"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="
	bison
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	openssl-dev
	pahole
	perl
	python3
	"

_config="config-$_flavor.$arch"
source="
	https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
	$_config
	sm8450-xiaomi-cupid.dts
	fork-0001-drm-panel-add-l3-42-02-0a-dsc-driver.patch
	fork-0002-input-touchscreen-add-fts_spi-driver.patch
	fork-0003-arm64-dts-qcom-sm8450-add-clock-names-to-mdss.patch
	fork-0004-arm64-dts-qcom-sm8450-add-low-svs-l2-opp.patch
	0002-fts-single-full-duplex-transfer-for-geni.patch
	0003-fts-palm-rejection-and-panel-follower.patch
	0026-fts-look-up-gpios-without-of_get_named_gpio.patch
	0027-pci-qcom-honour-iommu-cells-in-bdf-to-sid-table.patch
	0005-ath11k-reset-the-firmware-when-wmi-stops-answering.patch
	0006-q6apm-poll-for-spf-readiness-like-the-downstream-driver.patch
	0007-pdr-ack-service-up-before-notifying-clients.patch
	0008-apr-install-the-gpr-callback-before-probing.patch
	0010-battmgr-stop-requesting-properties-the-firmware-never-answers.patch
	0011-panel-l3-42-02-0a-brightness-refresh-rate-and-timing-tails.patch
	0012-ipa-add-ipa-v5.1-for-sm8450.patch
	0013-arm64-dts-sm8450-add-ipa-node.patch
	0019-input-add-awinic-aw8697-haptics-driver.patch
	0020-battmgr-translate-xiaomi-battery-property-ids.patch
	0021-media-qcom-camss-add-sm8450-support.patch
	0022-clk-qcom-camcc-sm8450-park-rcgs-on-xo.patch
	0023-mfd-qcom-pm8008-make-the-interrupt-optional.patch
	0024-media-i2c-ov13b10-devicetree-match.patch
	0025-drm-msm-dpu-one-dsc-encoder-for-single-slice-panels.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare

	# The devicetree is maintained outside the tree; mainline has no cupid
	# entry in the Makefile, so dtbs_install would skip it.
	cp "$srcdir"/sm8450-xiaomi-cupid.dts \
		arch/arm64/boot/dts/qcom/sm8450-xiaomi-cupid.dts
	grep -q 'sm8450-xiaomi-cupid.dtb' arch/arm64/boot/dts/qcom/Makefile ||
		echo 'dtb-$(CONFIG_ARCH_QCOM)	+= sm8450-xiaomi-cupid.dtb' \
			>> arch/arm64/boot/dts/qcom/Makefile

	cp "$srcdir/$_config" .config
	make ARCH="$_carch" CC="${CC:-gcc}" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

