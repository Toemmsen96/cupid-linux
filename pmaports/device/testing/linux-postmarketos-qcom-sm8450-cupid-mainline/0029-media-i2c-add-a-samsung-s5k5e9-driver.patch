From 4d0923f83b6c0ec27fbdce47fd24e4557c357b06 Mon Sep 17 00:00:00 2001
From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:35:22 +0100
Subject: [PATCH] media: i2c: add a Samsung S5K5E9 driver

The S5K5E9 is the 5 megapixel telemacro camera of the Xiaomi 12 (cupid).
One fixed mode, 2592x1944 RAW10 (GRBG) at 30 fps over two D-PHY lanes at
876.8 Mbps from a 19.2 MHz MCLK. The register sequences and the power
sequence are those of the stock CamX sensor module
(com.qti.sensormodule.cupid_sunny_s5k5e9_macro), decoded from the vendor
partition. Exposure, analogue gain, vertical blanking and the SMIA test
patterns are exposed as controls.

Verified on the phone: chip ID 0x559b at 0x2d on CCI1 bus 0, frames
through CSIPHY1/CSID0/VFE0, colour bars with the GRBG order.
---
 drivers/media/i2c/Kconfig  |  11 +
 drivers/media/i2c/Makefile |   1 +
 drivers/media/i2c/s5k5e9.c | 723 +++++++++++++++++++++++++++++++++++++
 3 files changed, 735 insertions(+)
 create mode 100644 drivers/media/i2c/s5k5e9.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 6b9f1b45c..716e4a473 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -821,6 +821,17 @@ config VIDEO_S5K5BAF
 	  This is a V4L2 sensor driver for Samsung S5K5BAF 2M
 	  camera sensor with an embedded SoC image signal processor.
 
+config VIDEO_S5K5E9
+	tristate "Samsung S5K5E9 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Samsung S5K5E9
+	  5 megapixel camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5k5e9.
+
 config VIDEO_S5K6A3
 	tristate "Samsung S5K6A3 sensor support"
 	help
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 23c8a0793..f4021c831 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -132,6 +132,7 @@ obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
 obj-$(CONFIG_VIDEO_S5C73M3) += s5c73m3/
 obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
 obj-$(CONFIG_VIDEO_S5K5BAF) += s5k5baf.o
+obj-$(CONFIG_VIDEO_S5K5E9) += s5k5e9.o
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
 obj-$(CONFIG_VIDEO_SAA6588) += saa6588.o
diff --git a/drivers/media/i2c/s5k5e9.c b/drivers/media/i2c/s5k5e9.c
new file mode 100644
index 000000000..e234b63aa
--- /dev/null
+++ b/drivers/media/i2c/s5k5e9.c
@@ -0,0 +1,723 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S5K5E9 image sensor driver
+ *
+ * One fixed mode: 2592x1944 RAW10 at 30 fps, two D-PHY lanes at
+ * 876.8 Mbps from a 19.2 MHz MCLK. The register sequences are those of the
+ * Xiaomi 12 macro camera module (CamX sensor module
+ * com.qti.sensormodule.cupid_sunny_s5k5e9_macro).
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define S5K5E9_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5K5E9_CHIP_ID			0x559b
+#define S5K5E9_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define S5K5E9_MODE_STANDBY		0x00
+#define S5K5E9_MODE_STREAMING		0x01
+#define S5K5E9_REG_ORIENTATION		CCI_REG8(0x0101)
+#define S5K5E9_REG_GROUP_HOLD		CCI_REG8(0x0104)
+#define S5K5E9_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K5E9_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define S5K5E9_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define S5K5E9_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define S5K5E9_MCLK_FREQ		(19200 * HZ_PER_KHZ)
+#define S5K5E9_AUTOSUSPEND_MS		2000
+
+/*
+ * PLLs from 19.2 MHz / 3 (0x0305): video timing 6.4 MHz * 89 (0x0307) =
+ * 569.6 MHz, output 6.4 MHz * 137 (0x030f) = 876.8 Mbps per lane, link
+ * frequency 438.4 MHz. The line length (0x0342) counts at 569.6 / 3 MHz,
+ * which gives the module's 30.05 fps at 3112 x 2030.
+ */
+#define S5K5E9_LINK_FREQ		438400000ULL
+#define S5K5E9_PIXEL_RATE		189866666ULL
+#define S5K5E9_NUM_LANES		2
+
+#define S5K5E9_NATIVE_WIDTH		2608
+#define S5K5E9_NATIVE_HEIGHT		1960
+#define S5K5E9_CROP_LEFT		8
+#define S5K5E9_CROP_TOP			8
+#define S5K5E9_WIDTH			2592
+#define S5K5E9_HEIGHT			1944
+
+#define S5K5E9_LINE_LENGTH		3112
+#define S5K5E9_FRAME_LENGTH		2030
+#define S5K5E9_FRAME_LENGTH_MAX		0xffff
+#define S5K5E9_EXPOSURE_MARGIN		8
+#define S5K5E9_EXPOSURE_MIN		2
+#define S5K5E9_EXPOSURE_DEFAULT		1000
+
+/* Analogue gain: 0x20 is 1x, up to 16x. */
+#define S5K5E9_ANA_GAIN_MIN		0x0020
+#define S5K5E9_ANA_GAIN_MAX		0x0200
+#define S5K5E9_ANA_GAIN_DEFAULT		0x0020
+
+#define S5K5E9_MBUS_CODE		MEDIA_BUS_FMT_SGRBG10_1X10
+
+/* In power-up order (the module's: VANA, VDIG, VIO); down in reverse. */
+static const char * const s5k5e9_supply_names[] = {
+	"avdd",		/* Analogue (2.8 V) */
+	"dvdd",		/* Digital core (1.2 V) */
+	"dovdd",	/* Digital I/O (1.8 V) */
+};
+
+static const char * const s5k5e9_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+	"Fade To Grey Colour Bars",
+	"PN9",
+};
+
+static const s64 s5k5e9_link_freq_menu[] = {
+	S5K5E9_LINK_FREQ,
+};
+
+static const struct cci_reg_sequence s5k5e9_init_regs[] = {
+	{ CCI_REG8(0x0100), 0x00 },
+	{ CCI_REG8(0x3b45), 0x01 },
+	{ CCI_REG8(0x0b05), 0x01 },
+	{ CCI_REG8(0x392f), 0x01 },
+	{ CCI_REG8(0x3930), 0x00 },
+	{ CCI_REG8(0x3924), 0x7f },
+	{ CCI_REG8(0x3925), 0xfd },
+	{ CCI_REG8(0x3c08), 0xff },
+	{ CCI_REG8(0x3c09), 0xff },
+	{ CCI_REG8(0x3c31), 0xff },
+	{ CCI_REG8(0x3c32), 0xff },
+	{ CCI_REG8(0x3290), 0x10 },
+	{ CCI_REG8(0x3200), 0x01 },
+	{ CCI_REG8(0x3074), 0x06 },
+	{ CCI_REG8(0x3075), 0x2f },
+	{ CCI_REG8(0x308a), 0x20 },
+	{ CCI_REG8(0x308b), 0x08 },
+	{ CCI_REG8(0x308c), 0x0b },
+	{ CCI_REG8(0x3081), 0x07 },
+	{ CCI_REG8(0x307b), 0x85 },
+	{ CCI_REG8(0x307a), 0x0a },
+	{ CCI_REG8(0x3079), 0x0a },
+	{ CCI_REG8(0x306e), 0x71 },
+	{ CCI_REG8(0x306f), 0x28 },
+	{ CCI_REG8(0x301f), 0x20 },
+	{ CCI_REG8(0x3012), 0x4e },
+	{ CCI_REG8(0x306b), 0x9a },
+	{ CCI_REG8(0x3091), 0x16 },
+	{ CCI_REG8(0x30c4), 0x06 },
+	{ CCI_REG8(0x306a), 0x79 },
+	{ CCI_REG8(0x30b0), 0xff },
+	{ CCI_REG8(0x306d), 0x08 },
+	{ CCI_REG8(0x3084), 0x16 },
+	{ CCI_REG8(0x3070), 0x0f },
+	{ CCI_REG8(0x30c2), 0x05 },
+	{ CCI_REG8(0x3069), 0x87 },
+	{ CCI_REG8(0x3c0f), 0x00 },
+	{ CCI_REG8(0x3083), 0x14 },
+	{ CCI_REG8(0x3080), 0x08 },
+	{ CCI_REG8(0x3c34), 0xea },
+	{ CCI_REG8(0x3c35), 0x5c },
+	{ CCI_REG8(0x3931), 0x02 },
+};
+
+static const struct cci_reg_sequence s5k5e9_2592x1944_regs[] = {
+	{ CCI_REG8(0x0100), 0x00 },
+	{ CCI_REG8(0x0136), 0x13 },
+	{ CCI_REG8(0x0137), 0x33 },
+	{ CCI_REG8(0x0305), 0x03 },
+	{ CCI_REG8(0x0306), 0x00 },
+	{ CCI_REG8(0x0307), 0x59 },
+	{ CCI_REG8(0x030d), 0x03 },
+	{ CCI_REG8(0x030e), 0x00 },
+	{ CCI_REG8(0x030f), 0x89 },
+	{ CCI_REG8(0x3c1f), 0x00 },
+	{ CCI_REG8(0x3c17), 0x00 },
+	{ CCI_REG8(0x0112), 0x0a },
+	{ CCI_REG8(0x0113), 0x0a },
+	{ CCI_REG8(0x0114), 0x01 },
+	{ CCI_REG8(0x0820), 0x03 },
+	{ CCI_REG8(0x0821), 0x6c },
+	{ CCI_REG8(0x0822), 0x00 },
+	{ CCI_REG8(0x0823), 0x00 },
+	{ CCI_REG8(0x3929), 0x0f },
+	{ CCI_REG8(0x0344), 0x00 },
+	{ CCI_REG8(0x0345), 0x08 },
+	{ CCI_REG8(0x0346), 0x00 },
+	{ CCI_REG8(0x0347), 0x08 },
+	{ CCI_REG8(0x0348), 0x0a },
+	{ CCI_REG8(0x0349), 0x27 },
+	{ CCI_REG8(0x034a), 0x07 },
+	{ CCI_REG8(0x034b), 0x9f },
+	{ CCI_REG8(0x034c), 0x0a },
+	{ CCI_REG8(0x034d), 0x20 },
+	{ CCI_REG8(0x034e), 0x07 },
+	{ CCI_REG8(0x034f), 0x98 },
+	{ CCI_REG8(0x0900), 0x00 },
+	{ CCI_REG8(0x0901), 0x00 },
+	{ CCI_REG8(0x0381), 0x01 },
+	{ CCI_REG8(0x0383), 0x01 },
+	{ CCI_REG8(0x0385), 0x01 },
+	{ CCI_REG8(0x0387), 0x01 },
+	{ CCI_REG8(0x0101), 0x00 },
+	{ CCI_REG8(0x0340), 0x07 },
+	{ CCI_REG8(0x0341), 0xee },
+	{ CCI_REG8(0x0342), 0x0c },
+	{ CCI_REG8(0x0343), 0x28 },
+	{ CCI_REG8(0x0200), 0x0b },
+	{ CCI_REG8(0x0201), 0x9c },
+	{ CCI_REG8(0x0202), 0x00 },
+	{ CCI_REG8(0x0203), 0x02 },
+	{ CCI_REG8(0x30b8), 0x2e },
+	{ CCI_REG8(0x30ba), 0x36 },
+};
+
+struct s5k5e9 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5k5e9_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+};
+
+static inline struct s5k5e9 *to_s5k5e9(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k5e9, sd);
+}
+
+static int s5k5e9_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k5e9 *s = container_of(ctrl->handler, struct s5k5e9, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		u32 max = S5K5E9_HEIGHT + ctrl->val - S5K5E9_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(s->exposure,
+					       s->exposure->minimum, max,
+					       s->exposure->step,
+					       min_t(u32, max,
+						     s->exposure->default_value));
+		if (ret)
+			return ret;
+	}
+
+	if (pm_runtime_get_if_in_use(s->dev) <= 0)
+		return 0;
+
+	cci_write(s->regmap, S5K5E9_REG_GROUP_HOLD, 1, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s->regmap, S5K5E9_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s->regmap, S5K5E9_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s->regmap, S5K5E9_REG_FRAME_LENGTH,
+			  S5K5E9_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(s->regmap, S5K5E9_REG_TEST_PATTERN, ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(s->regmap, S5K5E9_REG_GROUP_HOLD, 0, &ret);
+
+	pm_runtime_put_autosuspend(s->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k5e9_ctrl_ops = {
+	.s_ctrl = s5k5e9_set_ctrl,
+};
+
+static int s5k5e9_init_controls(struct s5k5e9 *s)
+{
+	struct v4l2_ctrl_handler *hdl = &s->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank = S5K5E9_LINE_LENGTH - S5K5E9_WIDTH;
+	u32 vblank = S5K5E9_FRAME_LENGTH - S5K5E9_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(s->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      s5k5e9_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, S5K5E9_PIXEL_RATE,
+			  S5K5E9_PIXEL_RATE, 1, S5K5E9_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &s5k5e9_ctrl_ops, V4L2_CID_VBLANK, vblank,
+			  S5K5E9_FRAME_LENGTH_MAX - S5K5E9_HEIGHT, 1, vblank);
+
+	s->exposure = v4l2_ctrl_new_std(hdl, &s5k5e9_ctrl_ops,
+					V4L2_CID_EXPOSURE, S5K5E9_EXPOSURE_MIN,
+					S5K5E9_FRAME_LENGTH -
+					S5K5E9_EXPOSURE_MARGIN,
+					1, S5K5E9_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &s5k5e9_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K5E9_ANA_GAIN_MIN, S5K5E9_ANA_GAIN_MAX, 1,
+			  S5K5E9_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &s5k5e9_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k5e9_test_pattern_menu) - 1,
+				     0, 0, s5k5e9_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &s5k5e9_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(s->dev, ret, "control init failed\n");
+	}
+
+	s->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int s5k5e9_identify(struct s5k5e9 *s)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(s->regmap, S5K5E9_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(s->dev, ret, "failed to read chip ID\n");
+	if (id != S5K5E9_CHIP_ID)
+		return dev_err_probe(s->dev, -ENODEV,
+				     "chip ID %#06llx, expected %#06x\n",
+				     id, S5K5E9_CHIP_ID);
+
+	return 0;
+}
+
+static int s5k5e9_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k5e9 *s = to_s5k5e9(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(s->regmap, s5k5e9_init_regs,
+				  ARRAY_SIZE(s5k5e9_init_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(s->regmap, s5k5e9_2592x1944_regs,
+					  ARRAY_SIZE(s5k5e9_2592x1944_regs),
+					  NULL);
+	if (ret) {
+		dev_err(s->dev, "failed to write registers: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(s->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(s->regmap, S5K5E9_REG_MODE_SELECT,
+			S5K5E9_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(s->dev);
+	return ret;
+}
+
+static int s5k5e9_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k5e9 *s = to_s5k5e9(sd);
+	int ret;
+
+	ret = cci_write(s->regmap, S5K5E9_REG_MODE_SELECT,
+			S5K5E9_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s->dev);
+
+	return ret;
+}
+
+static void s5k5e9_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = S5K5E9_WIDTH;
+	fmt->height = S5K5E9_HEIGHT;
+	fmt->code = S5K5E9_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k5e9_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = S5K5E9_MBUS_CODE;
+
+	return 0;
+}
+
+static int s5k5e9_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != S5K5E9_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = S5K5E9_WIDTH;
+	fse->max_width = S5K5E9_WIDTH;
+	fse->min_height = S5K5E9_HEIGHT;
+	fse->max_height = S5K5E9_HEIGHT;
+
+	return 0;
+}
+
+static int s5k5e9_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	s5k5e9_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k5e9_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = S5K5E9_CROP_LEFT;
+		sel->r.top = S5K5E9_CROP_TOP;
+		sel->r.width = S5K5E9_WIDTH;
+		sel->r.height = S5K5E9_HEIGHT;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5K5E9_NATIVE_WIDTH;
+		sel->r.height = S5K5E9_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int s5k5e9_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	s5k5e9_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k5e9_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k5e9_pad_ops = {
+	.enum_mbus_code = s5k5e9_enum_mbus_code,
+	.enum_frame_size = s5k5e9_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k5e9_set_format,
+	.get_selection = s5k5e9_get_selection,
+	.enable_streams = s5k5e9_enable_streams,
+	.disable_streams = s5k5e9_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k5e9_subdev_ops = {
+	.video = &s5k5e9_video_ops,
+	.pad = &s5k5e9_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k5e9_internal_ops = {
+	.init_state = s5k5e9_init_state,
+};
+
+static int s5k5e9_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e9 *s = to_s5k5e9(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(s->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	for (i = 0; i < ARRAY_SIZE(s->supplies); i++) {
+		ret = regulator_enable(s->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				s->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+	}
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(s->reset_gpio, 0);
+	usleep_range(2000, 2500);
+
+	ret = clk_prepare_enable(s->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_reset;
+	}
+	/* The module waits 2 ms after MCLK before the first access. */
+	usleep_range(5000, 6000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(s->reset_gpio, 1);
+err_supplies:
+	while (i--)
+		regulator_disable(s->supplies[i].consumer);
+	return ret;
+}
+
+static int s5k5e9_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e9 *s = to_s5k5e9(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(s->mclk);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(s->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	for (i = ARRAY_SIZE(s->supplies); i--;)
+		regulator_disable(s->supplies[i].consumer);
+
+	return 0;
+}
+
+static int s5k5e9_parse_endpoint(struct s5k5e9 *s)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(s->dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(s->dev, -EINVAL, "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(s->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != S5K5E9_NUM_LANES) {
+		ret = dev_err_probe(s->dev, -EINVAL,
+				    "%u data lanes unsupported, need %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes,
+				    S5K5E9_NUM_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       s5k5e9_link_freq_menu,
+				       ARRAY_SIZE(s5k5e9_link_freq_menu),
+				       &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int s5k5e9_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k5e9 *s;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	s->dev = dev;
+	v4l2_i2c_subdev_init(&s->sd, client, &s5k5e9_subdev_ops);
+
+	ret = s5k5e9_parse_endpoint(s);
+	if (ret)
+		return ret;
+
+	s->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s->regmap))
+		return dev_err_probe(dev, PTR_ERR(s->regmap),
+				     "failed to init CCI\n");
+
+	s->mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s->mclk))
+		return dev_err_probe(dev, PTR_ERR(s->mclk),
+				     "failed to get clock\n");
+
+	rate = clk_get_rate(s->mclk);
+	if (rate != S5K5E9_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock %lu Hz unsupported, need %lu Hz\n",
+				     rate, S5K5E9_MCLK_FREQ);
+
+	s->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5k5e9_supply_names); i++)
+		s->supplies[i].supply = s5k5e9_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s->supplies),
+				      s->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = s5k5e9_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = s5k5e9_identify(s);
+	if (ret)
+		goto err_power_off;
+
+	ret = s5k5e9_init_controls(s);
+	if (ret)
+		goto err_power_off;
+
+	s->sd.internal_ops = &s5k5e9_internal_ops;
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	s->sd.state_lock = s->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, S5K5E9_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_rpm;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(dev);
+	pm_runtime_put_noidle(dev);
+	v4l2_subdev_cleanup(&s->sd);
+err_entity:
+	media_entity_cleanup(&s->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+err_power_off:
+	s5k5e9_power_off(dev);
+	return ret;
+}
+
+static void s5k5e9_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k5e9 *s = to_s5k5e9(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+
+	pm_runtime_disable(s->dev);
+	if (!pm_runtime_status_suspended(s->dev))
+		s5k5e9_power_off(s->dev);
+	pm_runtime_set_suspended(s->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(s5k5e9_pm_ops, s5k5e9_power_off,
+				 s5k5e9_power_on, NULL);
+
+static const struct of_device_id s5k5e9_of_match[] = {
+	{ .compatible = "samsung,s5k5e9" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5k5e9_of_match);
+
+static struct i2c_driver s5k5e9_driver = {
+	.driver = {
+		.name = "s5k5e9",
+		.of_match_table = s5k5e9_of_match,
+		.pm = pm_ptr(&s5k5e9_pm_ops),
+	},
+	.probe = s5k5e9_probe,
+	.remove = s5k5e9_remove,
+};
+module_i2c_driver(s5k5e9_driver);
+
+MODULE_DESCRIPTION("Samsung S5K5E9 image sensor driver");
+MODULE_LICENSE("GPL");
