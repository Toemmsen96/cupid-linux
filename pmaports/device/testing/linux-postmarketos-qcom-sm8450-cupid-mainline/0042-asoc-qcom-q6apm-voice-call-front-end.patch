@@ -911,13 +927,43 @@
  */
 #define Q6APM_RAW_TOKEN		0x52415721
 
+/*
+ * Send [u32 opcode][payload] to the APM and wait for the response, which is
+ * left in raw_rsp*. Caller holds raw_lock.
+ */
+static int q6apm_raw_send(struct q6apm *apm, const void *buf, size_t len)
+{
+	struct gpr_pkt *pkt;
+	int ret;
+
+	lockdep_assert_held(&apm->raw_lock);
+
+	if (len < sizeof(u32))
+		return -EINVAL;
+
+	pkt = audioreach_alloc_apm_pkt(len - sizeof(u32), get_unaligned_le32(buf),
+				       Q6APM_RAW_TOKEN, GPR_APM_MODULE_IID);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+	memcpy((void *)pkt + GPR_HDR_SIZE, buf + sizeof(u32), len - sizeof(u32));
+
+	apm->raw_done = false;
+	apm->raw_rsp_len = 0;
+	apm->raw_rsp_opcode = 0;
+	ret = gpr_send_pkt(apm->gdev, pkt);
+	if (ret >= 0)
+		ret = wait_event_timeout(apm->raw_wait, apm->raw_done, 5 * HZ) ?
+		      0 : -ETIMEDOUT;
+	kfree(pkt);
+
+	return ret;
+}
+
