+struct imx766 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx766_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+};
+
+static inline struct imx766 *to_imx766(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx766, sd);
+}
+
+static int imx766_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx766 *s = container_of(ctrl->handler, struct imx766, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		u32 max = IMX766_HEIGHT + ctrl->val - IMX766_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(s->exposure,
+					       s->exposure->minimum, max,
+					       s->exposure->step,
+					       min_t(u32, max,
+						     s->exposure->default_value));
+		if (ret)
+			return ret;
+	}
+
+	if (pm_runtime_get_if_in_use(s->dev) <= 0)
+		return 0;
+
+	cci_write(s->regmap, IMX766_REG_GROUP_HOLD, 1, &ret);
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s->regmap, IMX766_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s->regmap, IMX766_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s->regmap, IMX766_REG_FRAME_LENGTH,
+			  IMX766_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(s->regmap, IMX766_REG_TEST_PATTERN, ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	cci_write(s->regmap, IMX766_REG_GROUP_HOLD, 0, &ret);
+
+	pm_runtime_put_autosuspend(s->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx766_ctrl_ops = {
+	.s_ctrl = imx766_set_ctrl,
+};
+
+static int imx766_init_controls(struct imx766 *s)
+{
+	struct v4l2_ctrl_handler *hdl = &s->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank = IMX766_LINE_LENGTH - IMX766_WIDTH;
+	u32 vblank = IMX766_FRAME_LENGTH - IMX766_HEIGHT;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(s->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 9);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ, 0, 0,
+				      imx766_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, IMX766_PIXEL_RATE,
+			  IMX766_PIXEL_RATE, 1, IMX766_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_VBLANK, vblank,
+			  IMX766_FRAME_LENGTH_MAX - IMX766_HEIGHT, 1, vblank);
+
+	s->exposure = v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops,
+					V4L2_CID_EXPOSURE, IMX766_EXPOSURE_MIN,
+					IMX766_FRAME_LENGTH -
+					IMX766_EXPOSURE_MARGIN,
+					1, IMX766_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx766_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX766_ANA_GAIN_MIN, IMX766_ANA_GAIN_MAX, 1,
+			  IMX766_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx766_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx766_test_pattern_menu) - 1,
+				     0, 0, imx766_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &imx766_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(s->dev, ret, "control init failed\n");
+	}
+
+	s->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int imx766_identify(struct imx766 *s)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(s->regmap, IMX766_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(s->dev, ret, "failed to read chip ID\n");
+	if (id != IMX766_CHIP_ID)
+		return dev_err_probe(s->dev, -ENODEV,
+				     "chip ID %#06llx, expected %#06x\n",
+				     id, IMX766_CHIP_ID);
+
+	return 0;
+}
+
+static int imx766_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx766 *s = to_imx766(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(s->regmap, imx766_init_regs,
+				  ARRAY_SIZE(imx766_init_regs), NULL);
+	if (!ret)
+		ret = cci_multi_reg_write(s->regmap, imx766_4096x3072_regs,
+					  ARRAY_SIZE(imx766_4096x3072_regs),
+					  NULL);
+	if (ret) {
+		dev_err(s->dev, "failed to write registers: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(s->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(s->regmap, IMX766_REG_ORIENTATION,
+			IMX766_ORIENTATION, NULL);
+	if (!ret)
+		ret = cci_write(s->regmap, IMX766_REG_MODE_SELECT,
+				IMX766_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(s->dev);
+	return ret;
+}
+
+static int imx766_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx766 *s = to_imx766(sd);
+	int ret;
+
+	ret = cci_write(s->regmap, IMX766_REG_MODE_SELECT,
+			IMX766_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s->dev);
+
+	return ret;
+}
+
+static void imx766_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = IMX766_WIDTH;
+	fmt->height = IMX766_HEIGHT;
+	fmt->code = IMX766_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx766_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = IMX766_MBUS_CODE;
+
+	return 0;
+}
+
+static int imx766_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != IMX766_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = IMX766_WIDTH;
+	fse->max_width = IMX766_WIDTH;
+	fse->min_height = IMX766_HEIGHT;
+	fse->max_height = IMX766_HEIGHT;
+
+	return 0;
+}
+
+static int imx766_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	imx766_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int imx766_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* The mode reads the whole array and bins it 2x2. */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX766_NATIVE_WIDTH;
+		sel->r.height = IMX766_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx766_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	imx766_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops imx766_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx766_pad_ops = {
+	.enum_mbus_code = imx766_enum_mbus_code,
+	.enum_frame_size = imx766_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx766_set_format,
+	.get_selection = imx766_get_selection,
+	.enable_streams = imx766_enable_streams,
+	.disable_streams = imx766_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx766_subdev_ops = {
+	.video = &imx766_video_ops,
+	.pad = &imx766_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx766_internal_ops = {
+	.init_state = imx766_init_state,
+};
+
+static int imx766_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx766 *s = to_imx766(sd);
+	unsigned int i;
+	int ret;
+
+	gpiod_set_value_cansleep(s->reset_gpio, 1);
+
+	for (i = 0; i < ARRAY_SIZE(s->supplies); i++) {
+		ret = regulator_enable(s->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				s->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+	}
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(s->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	ret = clk_prepare_enable(s->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_reset;
+	}
+	/* The module waits 2 ms after MCLK before the first access. */
+	usleep_range(5000, 6000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(s->reset_gpio, 1);
+err_supplies:
+	while (i--)
+		regulator_disable(s->supplies[i].consumer);
+	return ret;
+}
+
+static int imx766_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx766 *s = to_imx766(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(s->mclk);
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(s->reset_gpio, 1);
+	usleep_range(1000, 1500);
+
+	for (i = ARRAY_SIZE(s->supplies); i--;)
+		regulator_disable(s->supplies[i].consumer);
+
+	return 0;
+}
+
+static int imx766_parse_endpoint(struct imx766 *s)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_CPHY };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(s->dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(s->dev, -EINVAL, "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(s->dev, ret, "failed to parse endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != IMX766_NUM_TRIOS) {
+		ret = dev_err_probe(s->dev, -EINVAL,
+				    "%u trios unsupported, need %u\n",
+				    ep.bus.mipi_csi2.num_data_lanes,
+				    IMX766_NUM_TRIOS);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       imx766_link_freq_menu,
+				       ARRAY_SIZE(imx766_link_freq_menu),
+				       &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int imx766_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx766 *s;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	s->dev = dev;
+	v4l2_i2c_subdev_init(&s->sd, client, &imx766_subdev_ops);
+
+	ret = imx766_parse_endpoint(s);
+	if (ret)
+		return ret;
+
+	s->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s->regmap))
+		return dev_err_probe(dev, PTR_ERR(s->regmap),
+				     "failed to init CCI\n");
+
+	s->mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s->mclk))
+		return dev_err_probe(dev, PTR_ERR(s->mclk),
+				     "failed to get clock\n");
+
+	rate = clk_get_rate(s->mclk);
+	if (rate != IMX766_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock %lu Hz unsupported, need %lu Hz\n",
+				     rate, IMX766_MCLK_FREQ);
+
+	s->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(imx766_supply_names); i++)
+		s->supplies[i].supply = imx766_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s->supplies),
+				      s->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ret = imx766_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx766_identify(s);
+	if (ret)
+		goto err_power_off;
+
+	ret = imx766_init_controls(s);
+	if (ret)
+		goto err_power_off;
+
+	s->sd.internal_ops = &imx766_internal_ops;
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto err_free_ctrls;
+	}
+
+	s->sd.state_lock = s->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init subdev\n");
+		goto err_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, IMX766_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register subdev\n");
+		goto err_rpm;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(dev);
+	pm_runtime_put_noidle(dev);
+	v4l2_subdev_cleanup(&s->sd);
+err_entity:
+	media_entity_cleanup(&s->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+err_power_off:
+	imx766_power_off(dev);
+	return ret;
+}
+
+static void imx766_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx766 *s = to_imx766(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+
+	pm_runtime_disable(s->dev);
+	if (!pm_runtime_status_suspended(s->dev))
+		imx766_power_off(s->dev);
+	pm_runtime_set_suspended(s->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx766_pm_ops, imx766_power_off,
+				 imx766_power_on, NULL);
+
+static const struct of_device_id imx766_of_match[] = {
+	{ .compatible = "sony,imx766" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx766_of_match);
+
+static struct i2c_driver imx766_driver = {
+	.driver = {
+		.name = "imx766",
+		.of_match_table = imx766_of_match,
+		.pm = pm_ptr(&imx766_pm_ops),
+	},
+	.probe = imx766_probe,
+	.remove = imx766_remove,
+};
+module_i2c_driver(imx766_driver);
+
+MODULE_DESCRIPTION("Sony IMX766 image sensor driver");
+MODULE_LICENSE("GPL");
