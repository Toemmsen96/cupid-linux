From 3d14c7398957b864379a7a5dc5194d70a07f25c1 Mon Sep 17 00:00:00 2001
From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:45:04 +0100
Subject: [PATCH] media: i2c: add a Sony IMX766 driver

The IMX766 is the 50 megapixel main camera of the Xiaomi 12 (cupid),
connected over three MIPI C-PHY trios. One fixed mode: 4096x3072 RAW10
(2x2 binned full array, BGGR as mounted) at 30 fps, 1713.6 Msps per trio
from a 19.2 MHz MCLK. The register sequences and the power sequence are
those of the stock CamX sensor module
(com.qti.sensormodule.cupid_semco_imx766_wide), decoded from the vendor
partition. Exposure, analogue gain (Sony 16384 / (16384 - code), up to
64x), vertical blanking and the test patterns are exposed as controls.

Verified on the phone: chip ID 0x0766 at 0x10 on CCI0 bus 1, frames
through CSIPHY2 (C-PHY)/CSID0/VFE0, colour bars and real images.

Signed-off-by: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/imx766.c | 1457 ++++++++++++++++++++++++++++++++++++
 3 files changed, 1469 insertions(+)
 create mode 100644 drivers/media/i2c/imx766.c

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 716e4a473..6b274f8c9 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -299,6 +299,17 @@ config VIDEO_IMX471
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx471.
 
+config VIDEO_IMX766
+	tristate "Sony IMX766 sensor support"
+	depends on OF && GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the Sony IMX766
+	  50 megapixel camera, connected over MIPI C-PHY.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called imx766.
+
 config VIDEO_IMX678
 	tristate "Sony IMX678 sensor support"
 	depends on GPIOLIB
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index f4021c831..03d2ee846 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -62,6 +62,7 @@ obj-$(CONFIG_VIDEO_IMX355) += imx355.o
 obj-$(CONFIG_VIDEO_IMX412) += imx412.o
 obj-$(CONFIG_VIDEO_IMX415) += imx415.o
 obj-$(CONFIG_VIDEO_IMX678) += imx678.o
+obj-$(CONFIG_VIDEO_IMX766) += imx766.o
 obj-$(CONFIG_VIDEO_IMX471) += imx471.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
diff --git a/drivers/media/i2c/imx766.c b/drivers/media/i2c/imx766.c
new file mode 100644
index 000000000..94d1c98c7
--- /dev/null
+++ b/drivers/media/i2c/imx766.c
@@ -0,0 +1,1457 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX766 image sensor driver
+ *
+ * One fixed mode: 4096x3072 RAW10 (2x2 binned full array) at 30 fps over
+ * three MIPI C-PHY trios at 1713.6 Msps from a 19.2 MHz MCLK. The register
+ * sequences and the power sequence are those of the Xiaomi 12 main camera
+ * module (CamX sensor module com.qti.sensormodule.cupid_semco_imx766_wide).
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define IMX766_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX766_CHIP_ID			0x0766
+#define IMX766_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX766_MODE_STANDBY		0x00
+#define IMX766_MODE_STREAMING		0x01
+#define IMX766_REG_ORIENTATION		CCI_REG8(0x0101)
+#define IMX766_REG_GROUP_HOLD		CCI_REG8(0x0104)
+#define IMX766_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX766_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX766_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define IMX766_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define IMX766_MCLK_FREQ		(19200 * HZ_PER_KHZ)
+#define IMX766_AUTOSUSPEND_MS		2000
+
+/*
+ * Output PLL: 19.2 MHz / 2 (0x030d) * 357 (0x030e/f) = 3427.2 MHz, 1713.6
+ * Msps per trio. The link frequency of a C-PHY link is half the symbol
+ * rate. Video timing: 19.2 MHz / 3 * 175 (0x0307) = 1120 MHz; the line
+ * length (0x0342) counts at 1.6 times that, the module's 30.01 fps at
+ * 15616 x 3824.
+ */
+#define IMX766_LINK_FREQ		856800000ULL
+#define IMX766_PIXEL_RATE		1792000000ULL
+#define IMX766_NUM_TRIOS		3
+
+#define IMX766_NATIVE_WIDTH		8192
+#define IMX766_NATIVE_HEIGHT		6144
+#define IMX766_WIDTH			4096
+#define IMX766_HEIGHT			3072
+
+#define IMX766_LINE_LENGTH		15616
+#define IMX766_FRAME_LENGTH		3824
+#define IMX766_FRAME_LENGTH_MAX		0xffff
+#define IMX766_EXPOSURE_MARGIN		48
+#define IMX766_EXPOSURE_MIN		8
+#define IMX766_EXPOSURE_DEFAULT		2000
+
+/* Analogue gain code: gain = 16384 / (16384 - code), 1x to 64x. */
+#define IMX766_ANA_GAIN_MIN		0
+#define IMX766_ANA_GAIN_MAX		16128
+#define IMX766_ANA_GAIN_DEFAULT		0
+
+/*
+ * The module streams with 0x0101 = 3 (mirror and flip): mounted upside
+ * down. Read out that way the colour filter starts on blue (the test
+ * pattern generator sits after the readout and still decodes as RGGB).
+ */
+#define IMX766_ORIENTATION		0x03
+
+#define IMX766_MBUS_CODE		MEDIA_BUS_FMT_SBGGR10_1X10
+
+/*
+ * In power-up order (the module's: VANA, CUSTOM1, VDIG, VIO); down in
+ * reverse. The module's VAF (autofocus) and CUSTOM2 (pm8350 S12, always
+ * on) are left to their owners.
+ */
+static const char * const imx766_supply_names[] = {
+	"avdd",		/* Analogue (1.8 V) */
+	"avdd2",	/* Second analogue rail (3.1 V) */
+	"dvdd",		/* Digital core (1.1 V) */
+	"dovdd",	/* Digital I/O (1.8 V) */
+};
+
+static const char * const imx766_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+	"Fade To Grey Colour Bars",
+	"PN9",
+};
+
+static const s64 imx766_link_freq_menu[] = {
+	IMX766_LINK_FREQ,
+};
+
