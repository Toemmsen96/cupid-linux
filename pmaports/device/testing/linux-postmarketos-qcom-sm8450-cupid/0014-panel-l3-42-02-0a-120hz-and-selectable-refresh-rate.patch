diff --git a/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c b/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c
--- a/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c
+++ b/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c
@@ -8,6 +8,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
 #include <linux/mod_devicetable.h>
+#include <linux/moduleparam.h>
 
 #include <video/mipi_display.h>
 
@@ -28,6 +29,21 @@
 	bool prepared;
 };
 
+/*
+ * The panel refreshes from its own RAM at the rate selected by DCS 0x2f
+ * (stock timing@0/1/2: 0x01 = 60 Hz, 0x02 = 120 Hz, 0x03 = 90 Hz). At 60 Hz
+ * the OLED's PWM dimming visibly flickers; stock HyperOS runs at 120 Hz.
+ * Only one mode is exposed; pick it at load time.
+ */
+static unsigned int refresh_rate = 120;
+module_param(refresh_rate, uint, 0444);
+MODULE_PARM_DESC(refresh_rate, "Panel refresh rate in Hz: 60, 90 or 120 (default 120)");
+
+static unsigned int l3_42_02_0a_dsc_rate(void)
+{
+	return (refresh_rate == 60 || refresh_rate == 90) ? refresh_rate : 120;
+}
+
 static inline
 struct l3_42_02_0a_dsc *to_l3_42_02_0a_dsc(struct drm_panel *panel)
 {
@@ -82,9 +98,31 @@
 		return ret;
 	}
 
-	/* 60 Hz */
-	mipi_dsi_dcs_write_seq(dsi, 0x2f, 0x01);
-	mipi_dsi_dcs_write_seq(dsi, MIPI_DCS_SET_GAMMA_CURVE, 0x01);
+	/* Refresh rate, as in the stock on-command of each timing node */
+	switch (l3_42_02_0a_dsc_rate()) {
+	case 60:
+		mipi_dsi_dcs_write_seq(dsi, 0x2f, 0x01);
+		mipi_dsi_dcs_write_seq(dsi, MIPI_DCS_SET_GAMMA_CURVE, 0x01);
+		break;
+	case 90:
+		mipi_dsi_dcs_write_seq(dsi, 0x2f, 0x03);
+		mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x00);
+		mipi_dsi_dcs_write_seq(dsi, 0x6f, 0x0a);
+		mipi_dsi_dcs_write_seq(dsi, 0xc0, 0x01);
+		mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x02);
+		mipi_dsi_dcs_write_seq(dsi, 0xcc, 0x30);
+		mipi_dsi_dcs_write_seq(dsi, 0xce, 0x01);
+		msleep(20);
+		mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x02);
+		mipi_dsi_dcs_write_seq(dsi, 0xcc, 0x00);
+		break;
+	default: /* 120 */
+		mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x00);
+		mipi_dsi_dcs_write_seq(dsi, 0x6f, 0x09);
+		mipi_dsi_dcs_write_seq(dsi, 0xc0, 0x20);
+		mipi_dsi_dcs_write_seq(dsi, 0x2f, 0x02);
+		break;
+	}
 	/* OSC calibration */
 	mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x01);
 	mipi_dsi_dcs_write_seq(dsi, 0xc3,
@@ -274,7 +312,7 @@
 	return 0;
 }
 
-static const struct drm_display_mode l3_42_02_0a_dsc_mode = {
+static struct drm_display_mode l3_42_02_0a_dsc_mode = {
 	.clock = (1080 + 32 + 16 + 32) * (2400 + 64 + 16 + 32) * 60 / 1000,
 	.hdisplay = 1080,
 	.hsync_start = 1080 + 32,
@@ -292,6 +330,10 @@
 static int l3_42_02_0a_dsc_get_modes(struct drm_panel *panel,
 				     struct drm_connector *connector)
 {
+	/* same porches for every rate (stock timing@0/1/2), only the clock scales */
+	l3_42_02_0a_dsc_mode.clock = (1080 + 32 + 16 + 32) * (2400 + 64 + 16 + 32) *
+				     l3_42_02_0a_dsc_rate() / 1000;
+
 	return drm_connector_helper_get_modes_fixed(connector, &l3_42_02_0a_dsc_mode);
 }
 
