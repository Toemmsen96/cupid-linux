# Maintainer: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
# Kernel for the Xiaomi 12 (cupid).
#
# Why this exists instead of using linux-postmarketos-qcom-sm8450: that package
# pins a 2023 commit (v6.5) of the sm8450-mainline fork which predates the
# cupid devicetree, the cupid panel driver (panel-l3-42-02-0a-dsc.c) and the
# ST FTS SPI touch driver. All three live in the fork's next-new branch.
#
# This package pins next-new at 6.13.0-rc3, the exact tree the Xiaomi 12 Pro
# (zeus, same SoC and bootloader generation) port was brought up and verified
# on. The patches are the SM8450-generic bring-up fixes from that port
# (https://github.com/Blaze414/postmarketOS-zeus): touch reads over GENI SPI,
# PCIe link training for the WCN6855, ath11k recovery and the ADSP audio
# service races. The cupid devicetree ships here in full with the cupid fixes
# applied on top of the fork's version; see the cupid-linux README for the
# list.
_flavor="postmarketos-qcom-sm8450-cupid"
pkgname=linux-$_flavor
pkgver=6.13.0_rc3
pkgrel=4
pkgdesc="Mainline kernel fork for the Xiaomi 12 (cupid), 6.13-rc3 base with bring-up fixes"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm8450-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
# python3: drivers/gpu/drm/msm generates its register headers at build time
# with registers/gen_header.py.
makedepends="
	bison
	elfutils-dev
	findutils
	flex
	installkernel
	linux-headers
	openssl-dev
	pahole
	perl
	python3
	"

_repo="linux"
_config="config-$_flavor.$arch"
# sm8450-mainline/linux next-new, 2025-01-11, v6.13.0-rc3
_commit="bf1d29fced6e156dd6090a9b6600a8c44259c114"

source="
	$_repo-$_commit.tar.gz::https://github.com/sm8450-mainline/$_repo/archive/$_commit/$_repo-$_commit.tar.gz
	$_config
	sm8450-xiaomi-cupid.dts
	0002-fts-single-full-duplex-transfer-for-geni.patch
	0003-fts-palm-rejection-and-panel-follower.patch
	0004-pcie-qcom-retry-link-training-with-endpoint-reset.patch
	0005-ath11k-reset-the-firmware-when-wmi-stops-answering.patch
	0006-q6apm-poll-for-spf-readiness-like-the-downstream-driver.patch
	0007-pdr-ack-service-up-before-notifying-clients.patch
	0008-apr-install-the-gpr-callback-before-probing.patch
	0009-libbpf-const-correct-strstr-strchr-results.patch
	0010-battmgr-stop-requesting-properties-the-firmware-never-answers.patch
	0011-panel-l3-42-02-0a-keep-brightness-while-off-and-restore-lpm.patch
	0012-ipa-add-ipa-v5.1-for-sm8450.patch
	0013-arm64-dts-sm8450-add-ipa-node.patch
	0014-panel-l3-42-02-0a-120hz-and-selectable-refresh-rate.patch
	0015-msm-dsi-round-byte-clock-to-the-pll-rate.patch
"
builddir="$srcdir/$_repo-$_commit"

prepare() {
	default_prepare

	# The devicetree is maintained outside the tree: replace the fork's copy.
	cp "$srcdir"/sm8450-xiaomi-cupid.dts \
		arch/arm64/boot/dts/qcom/sm8450-xiaomi-cupid.dts

	cp "$srcdir/$_config" .config
	make ARCH="$_carch" CC="${CC:-gcc}" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

