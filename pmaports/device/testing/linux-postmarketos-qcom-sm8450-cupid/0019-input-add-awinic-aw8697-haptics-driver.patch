+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/awinic,aw8697.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW8697 LRA haptic driver
+
+maintainers:
+  - Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
+
+description:
+  I2C-controlled driver for linear resonant actuators with an integrated
+  boost converter and on-chip waveform SRAM.
+
+properties:
+  compatible:
+    const: awinic,aw8697
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  awinic,f0-preset-decihertz:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Nominal resonance frequency of the actuator in units of 0.1 Hz. The
+      measured resonance is used to trim the drive oscillator only when it is
+      within awinic,f0-tolerance-percent of this value.
+    default: 1700
+
+  awinic,f0-tolerance-percent:
+    description:
+      Largest deviation of the measured resonance from the preset that is
+      still trusted for calibration.
+    default: 9
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        haptics@5a {
+            compatible = "awinic,aw8697";
+            reg = <0x5a>;
+            interrupts-extended = <&tlmm 90 IRQ_TYPE_EDGE_FALLING>;
+            reset-gpios = <&tlmm 89 GPIO_ACTIVE_LOW>;
+        };
+    };
