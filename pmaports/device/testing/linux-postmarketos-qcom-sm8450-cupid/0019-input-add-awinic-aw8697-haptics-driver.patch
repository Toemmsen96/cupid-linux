+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Awinic AW8697 LRA haptic driver
+ *
+ * Minimal mainline-style driver for the AW8697 haptic controller as used in
+ * the Xiaomi 12 (cupid) and other SM8450 Xiaomi phones. It exposes a
+ * memoryless force-feedback (FF_RUMBLE) input device, which is what
+ * feedbackd and fftest expect.
+ *
+ * Playback uses the chip's RAM mode: at probe the waveform library
+ * (aw8697_haptic.bin, from the vendor firmware) is written into the chip
+ * SRAM, then a vibration loops one waveform entry until it is stopped, with
+ * the strength set through the digital gain. This is the "RAM loop" path of
+ * the downstream driver, which Android uses for every vibration of a given
+ * duration. Like downstream, the LRA resonance (f0) is measured once at
+ * probe and the drive oscillator is trimmed to it.
+ *
+ * Register map, tuning values and sequences are taken from Xiaomi's
+ * downstream driver (drivers/input/misc/aw8697_haptic, zeus-s-oss) and the
+ * cupid downstream devicetree.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define AW8697_REG_ID			0x00
+#define AW8697_REG_SYSINT		0x02
+#define AW8697_REG_SYSINTM		0x03
+#define AW8697_REG_SYSCTRL		0x04
+#define AW8697_REG_GO			0x05
+#define AW8697_REG_WAVSEQ1		0x07
+#define AW8697_REG_WAVSEQ2		0x08
+#define AW8697_REG_WAVLOOP1		0x0f
+#define AW8697_REG_MAIN_LOOP		0x13
+#define AW8697_REG_DBGCTRL		0x20
+#define AW8697_REG_BASE_ADDRH		0x21
+#define AW8697_REG_BASE_ADDRL		0x22
+#define AW8697_REG_FIFO_AEH		0x23
+#define AW8697_REG_FIFO_AEL		0x24
+#define AW8697_REG_FIFO_AFH		0x25
+#define AW8697_REG_FIFO_AFL		0x26
+#define AW8697_REG_DATCTRL		0x2b
+#define AW8697_REG_PWMPRC		0x2d
+#define AW8697_REG_PWMDBG		0x2e
+#define AW8697_REG_BSTDBG1		0x31
+#define AW8697_REG_BSTDBG2		0x32
+#define AW8697_REG_BSTDBG3		0x33
+#define AW8697_REG_BSTCFG		0x34
+#define AW8697_REG_ANADBG		0x35
+#define AW8697_REG_ANACTRL		0x36
+#define AW8697_REG_DATDBG		0x39
+#define AW8697_REG_BSTDBG4		0x3a
+#define AW8697_REG_PRLVL		0x3e
+#define AW8697_REG_RAMADDRH		0x40
+#define AW8697_REG_RAMADDRL		0x41
+#define AW8697_REG_RAMDATA		0x42
+#define AW8697_REG_GLB_STATE		0x46
+#define AW8697_REG_BST_AUTO		0x47
+#define AW8697_REG_CONT_CTRL		0x48
+#define AW8697_REG_F_PRE_H		0x49
+#define AW8697_REG_F_PRE_L		0x4a
+#define AW8697_REG_TSET			0x4d
+#define AW8697_REG_TRIM_LRA		0x5b
+#define AW8697_REG_R_SPARE		0x5d
+#define AW8697_REG_DETCTRL		0x5f
+#define AW8697_REG_VBATDET		0x62
+#define AW8697_REG_ADCTEST		0x66
+#define AW8697_REG_F_LRA_F0_H		0x68
+#define AW8697_REG_F_LRA_F0_L		0x69
+#define AW8697_REG_BEMF_VTHH_H		0x74
+#define AW8697_REG_BEMF_VTHH_L		0x75
+#define AW8697_REG_BEMF_VTHL_H		0x76
+#define AW8697_REG_BEMF_VTHL_L		0x77
+#define AW8697_REG_DRV_LVL		0x7b
+#define AW8697_REG_NUM_F0_1		0x7d
+#define AW8697_REG_NUM_F0_2		0x7e
+#define AW8697_REG_NUM_F0_3		0x7f
+#define AW8697_REG_MAX			0xff
+
+#define AW8697_CHIPID			0x97
+#define AW8697_SOFT_RESET		0xaa
+
+#define AW8697_SYSINTM_UVLO_OFF		BIT(5)
+
+#define AW8697_SYSCTRL_RAMINIT		BIT(5)
+#define AW8697_SYSCTRL_PLAY_MODE	GENMASK(3, 2)
+#define AW8697_SYSCTRL_PLAY_MODE_RAM	(0 << 2)
+#define AW8697_SYSCTRL_PLAY_MODE_CONT	(2 << 2)
+#define AW8697_SYSCTRL_BST_MODE_BOOST	BIT(1)
+#define AW8697_SYSCTRL_STANDBY		BIT(0)
+
+#define AW8697_GO			BIT(0)
+
+#define AW8697_WAVLOOP_SEQ1		GENMASK(7, 4)
+#define AW8697_WAVLOOP_INFINITE		0xf
+
+#define AW8697_DBGCTRL_INT_MODE_EDGE	BIT(3)
+
+#define AW8697_DATCTRL_FC		GENMASK(7, 6)
+#define AW8697_DATCTRL_FC_1000HZ	(3 << 6)
+#define AW8697_DATCTRL_LPF_EN		BIT(5)
+
+#define AW8697_PWMPRC_PRC_EN		BIT(7)
+#define AW8697_PWMDBG_PWM_MODE		GENMASK(6, 5)
+#define AW8697_PWMDBG_PWM_24K		(2 << 5)
+
+#define AW8697_BSTCFG_PEAKCUR		GENMASK(2, 0)
+#define AW8697_BSTCFG_PEAKCUR_3P5A	5
+
+#define AW8697_ANADBG_IOC		GENMASK(3, 2)
+#define AW8697_ANADBG_IOC_4P65A		(3 << 2)
+
+#define AW8697_ANACTRL_LRA_SRC_REG	BIT(5)
+
+#define AW8697_BSTDBG4_BSTVOL		GENMASK(5, 1)
+
+#define AW8697_PRLVL_PR_EN		BIT(7)
+
+#define AW8697_BST_AUTO_AUTOSW		BIT(2)
+
+#define AW8697_CONT_CTRL_CLOSE_PLAYBACK	BIT(3)
+#define AW8697_CONT_CTRL_F0_DETECT	BIT(2)
+
+#define AW8697_DETCTRL_PROTECT_NO_ACTION BIT(5)
+#define AW8697_DETCTRL_VBAT_GO		BIT(1)
+#define AW8697_DETCTRL_DIAG_GO		BIT(0)
+
+#define AW8697_ADCTEST_VBAT_HW_COMP	BIT(6)
+
+/* Waveform library header: 2 bytes checksum, 2 bytes SRAM base address. */
+#define AW8697_FW_HDR_LEN		4
+#define AW8697_FW_NAME			"aw8697_haptic.bin"
+
+/*
+ * Index of the waveform the downstream driver loops for timed vibrations
+ * ("effect_id_boundary + 1" with vib_effect_id_boundary = 10 on cupid).
+ */
+#define AW8697_LOOP_WAVEFORM		11
+
+/* Digital gain range used by the downstream driver (0x80 is unity). */
+#define AW8697_GAIN_MIN			0x1e
+#define AW8697_GAIN_MAX			0x80
+
+#define AW8697_VBAT_REFER_MV		4200
+#define AW8697_VBAT_MIN_MV		3000
+
+/*
+ * LRA and boost tuning from the cupid downstream devicetree. These are
+ * properties of the motor and the board, not of the chip, and are the
+ * defaults for every property the binding makes optional.
+ */
+#define AW8697_DEF_F0_PRE		1700	/* 0.1 Hz units: 170.0 Hz */
+#define AW8697_DEF_F0_CALI_PERCENT	9
+#define AW8697_DEF_CONT_DRV_LVL		56
+#define AW8697_F0_COEFF			260	/* fixed, "do not modify" */
+
+static const u8 aw8697_def_f0_trace[4] = { 0x05, 0x03, 0x02, 0x0f };
+static const u8 aw8697_def_bemf[4] = { 0x10, 0x08, 0x03, 0xf8 };
+static const u8 aw8697_def_bstdbg[3] = { 0x30, 0xeb, 0xd4 };
+#define AW8697_DEF_TSET			0x12
+#define AW8697_DEF_R_SPARE		0x68
+#define AW8697_DEF_BST_VOL		0x14
+
+struct aw8697 {
+	struct i2c_client *client;
+	struct regmap *regmap;
+	struct gpio_desc *reset_gpio;
+	struct input_dev *input;
+
+	/* Serialises all register access after probe. */
+	struct mutex lock;
+	struct work_struct play_work;
+
+	bool ram_ready;
+	/* Completed once the asynchronous waveform load has finished. */
+	struct completion fw_done;
+	u8 trim_lra;
+
+	/* Requested by the FF core, consumed by play_work. */
+	u16 magnitude;
+	bool playing;
+
+	u32 f0_pre;
+	u32 f0_cali_percent;
+	u32 cont_drv_lvl;
+	u8 bst_vol;
+};
+
+static const struct regmap_config aw8697_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = AW8697_REG_MAX,
+	/* RAMDATA and the status registers change underneath us. */
+	.cache_type = REGCACHE_NONE,
+};
+
+static int aw8697_wait_standby(struct aw8697 *aw)
+{
+	unsigned int val;
+	int i, ret;
+
+	for (i = 0; i < 100; i++) {
+		ret = regmap_read(aw->regmap, AW8697_REG_GLB_STATE, &val);
+		if (ret)
+			return ret;
+		if ((val & 0x0f) == 0)
+			return 0;
+		usleep_range(2000, 2500);
+	}
+
+	dev_warn(&aw->client->dev, "did not enter standby (state 0x%02x)\n",
+		 val);
+	return -ETIMEDOUT;
+}
+
+static void aw8697_set_active(struct aw8697 *aw, bool active)
+{
+	unsigned int val;
+
+	if (active) {
+		regmap_clear_bits(aw->regmap, AW8697_REG_SYSCTRL,
+				  AW8697_SYSCTRL_STANDBY);
+		/* Reading SYSINT clears latched interrupt flags. */
+		regmap_read(aw->regmap, AW8697_REG_SYSINT, &val);
+		regmap_clear_bits(aw->regmap, AW8697_REG_SYSINTM,
+				  AW8697_SYSINTM_UVLO_OFF);
+	} else {
+		regmap_set_bits(aw->regmap, AW8697_REG_SYSINTM,
+				AW8697_SYSINTM_UVLO_OFF);
+		regmap_set_bits(aw->regmap, AW8697_REG_SYSCTRL,
+				AW8697_SYSCTRL_STANDBY);
+	}
+}
+
+static void aw8697_stop(struct aw8697 *aw)
+{
+	regmap_clear_bits(aw->regmap, AW8697_REG_GO, AW8697_GO);
+	aw8697_wait_standby(aw);
+	aw8697_set_active(aw, false);
+}
+
+/* Battery voltage in mV, measured by the chip's own ADC. */
+static int aw8697_get_vbat(struct aw8697 *aw)
+{
+	unsigned int val;
+	int i, ret;
+
+	regmap_set_bits(aw->regmap, AW8697_REG_SYSCTRL, AW8697_SYSCTRL_RAMINIT);
+	regmap_set_bits(aw->regmap, AW8697_REG_DETCTRL, AW8697_DETCTRL_VBAT_GO);
+	for (i = 0; i < 100; i++) {
+		ret = regmap_read(aw->regmap, AW8697_REG_DETCTRL, &val);
+		if (ret || !(val & AW8697_DETCTRL_VBAT_GO))
+			break;
+		usleep_range(100, 200);
+	}
+	ret = regmap_read(aw->regmap, AW8697_REG_VBATDET, &val);
+	regmap_clear_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			  AW8697_SYSCTRL_RAMINIT);
+	if (ret)
+		return ret;
+
+	return 6100 * val / 256;
+}
+
+static u8 aw8697_magnitude_to_gain(struct aw8697 *aw, u16 magnitude)
+{
+	unsigned int gain;
+	int vbat;
+
+	gain = AW8697_GAIN_MIN +
+	       DIV_ROUND_CLOSEST((AW8697_GAIN_MAX - AW8697_GAIN_MIN) *
+				 (unsigned int)magnitude, 0xffff);
+
+	/*
+	 * RAM loop playback runs with the boost converter bypassed, so the
+	 * output follows the battery. Scale the gain to the 4.2 V reference
+	 * like downstream does, capped at the gain for a 3.0 V battery.
+	 */
+	vbat = aw8697_get_vbat(aw);
+	if (vbat > 0) {
+		gain = gain * AW8697_VBAT_REFER_MV / vbat;
+		gain = min_t(unsigned int, gain,
+			     AW8697_GAIN_MAX * AW8697_VBAT_REFER_MV /
+			     AW8697_VBAT_MIN_MV);
+	}
+
+	return min_t(unsigned int, gain, 0xff);
+}
+
+static void aw8697_play_loop(struct aw8697 *aw, u16 magnitude)
+{
+	regmap_write(aw->regmap, AW8697_REG_TRIM_LRA, aw->trim_lra);
+
+	/* Loop one waveform forever; the FF core times the stop. */
+	regmap_write(aw->regmap, AW8697_REG_WAVSEQ1, AW8697_LOOP_WAVEFORM);
+	regmap_write(aw->regmap, AW8697_REG_WAVSEQ2, 0);
+	regmap_update_bits(aw->regmap, AW8697_REG_WAVLOOP1,
+			   AW8697_WAVLOOP_SEQ1,
+			   FIELD_PREP(AW8697_WAVLOOP_SEQ1,
+				      AW8697_WAVLOOP_INFINITE));
+
+	regmap_write(aw->regmap, AW8697_REG_DATDBG,
+		     aw8697_magnitude_to_gain(aw, magnitude));
+
+	/* RAM mode, boost bypassed (downstream's RAM_LOOP mode). */
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			   AW8697_SYSCTRL_PLAY_MODE,
+			   AW8697_SYSCTRL_PLAY_MODE_RAM);
+	aw8697_set_active(aw, true);
+	regmap_clear_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			  AW8697_SYSCTRL_BST_MODE_BOOST);
+
+	regmap_set_bits(aw->regmap, AW8697_REG_GO, AW8697_GO);
+}
+
+static void aw8697_play_work(struct work_struct *work)
+{
+	struct aw8697 *aw = container_of(work, struct aw8697, play_work);
+	u16 magnitude;
+	bool playing;
+
+	mutex_lock(&aw->lock);
+	magnitude = READ_ONCE(aw->magnitude);
+	playing = READ_ONCE(aw->playing);
+
+	if (aw->ram_ready) {
+		aw8697_stop(aw);
+		if (playing)
+			aw8697_play_loop(aw, magnitude);
+	}
+	mutex_unlock(&aw->lock);
+}
+
+/* Called by ff-memless in atomic context. */
+static int aw8697_play_effect(struct input_dev *input, void *data,
+			      struct ff_effect *effect)
+{
+	struct aw8697 *aw = input_get_drvdata(input);
+	u16 magnitude;
+
+	if (effect->type != FF_RUMBLE)
+		return 0;
+
+	magnitude = max_t(u16, effect->u.rumble.strong_magnitude,
+			  effect->u.rumble.weak_magnitude / 2);
+
+	WRITE_ONCE(aw->magnitude, magnitude);
+	WRITE_ONCE(aw->playing, magnitude > 0);
+	schedule_work(&aw->play_work);
+
+	return 0;
+}
+
+static void aw8697_close(struct input_dev *input)
+{
+	struct aw8697 *aw = input_get_drvdata(input);
+
+	WRITE_ONCE(aw->playing, false);
+	cancel_work_sync(&aw->play_work);
+
+	mutex_lock(&aw->lock);
+	if (aw->ram_ready)
+		aw8697_stop(aw);
+	mutex_unlock(&aw->lock);
+}
+
+/*
+ * Measure the LRA resonance frequency with the chip's open-loop f0 detection
+ * and trim the drive oscillator so that the waveforms, which were authored
+ * for f0_pre, play at the motor's actual resonance.
+ */
+static void aw8697_f0_calibrate(struct aw8697 *aw)
+{
+	struct device *dev = &aw->client->dev;
+	unsigned int val, f0_reg, f0, f0_limit, trace_ms;
+	u8 n_pre, n_wait, n_repeat, n_trace;
+	int step, i;
+
+	n_pre = aw8697_def_f0_trace[0];
+	n_wait = aw8697_def_f0_trace[1];
+	n_repeat = aw8697_def_f0_trace[2];
+	n_trace = aw8697_def_f0_trace[3];
+
+	aw->trim_lra = 0;
+	regmap_write(aw->regmap, AW8697_REG_TRIM_LRA, 0);
+
+	aw8697_stop(aw);
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			   AW8697_SYSCTRL_PLAY_MODE,
+			   AW8697_SYSCTRL_PLAY_MODE_CONT);
+	regmap_clear_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			  AW8697_SYSCTRL_BST_MODE_BOOST);
+	aw8697_set_active(aw, true);
+
+	regmap_clear_bits(aw->regmap, AW8697_REG_CONT_CTRL,
+			  AW8697_CONT_CTRL_CLOSE_PLAYBACK);
+	regmap_set_bits(aw->regmap, AW8697_REG_CONT_CTRL,
+			AW8697_CONT_CTRL_F0_DETECT);
+
+	regmap_update_bits(aw->regmap, AW8697_REG_DATCTRL, AW8697_DATCTRL_FC,
+			   AW8697_DATCTRL_FC_1000HZ);
+	regmap_set_bits(aw->regmap, AW8697_REG_DATCTRL, AW8697_DATCTRL_LPF_EN);
+	regmap_set_bits(aw->regmap, AW8697_REG_ANACTRL,
+			AW8697_ANACTRL_LRA_SRC_REG);
+
+	f0_reg = 1000000000 / (aw->f0_pre * AW8697_F0_COEFF);
+	regmap_write(aw->regmap, AW8697_REG_F_PRE_H, (f0_reg >> 8) & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_F_PRE_L, f0_reg & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_DRV_LVL, aw->cont_drv_lvl);
+	regmap_write(aw->regmap, AW8697_REG_NUM_F0_1, (n_pre << 4) | n_wait);
+	regmap_write(aw->regmap, AW8697_REG_NUM_F0_2, n_repeat);
+	regmap_write(aw->regmap, AW8697_REG_NUM_F0_3, n_trace);
+
+	regmap_read(aw->regmap, AW8697_REG_SYSINT, &val);
+	regmap_set_bits(aw->regmap, AW8697_REG_GO, AW8697_GO);
+
+	/* f0_pre is in 0.1 Hz, so one period is 10000 / f0_pre ms. */
+	trace_ms = 10000 / aw->f0_pre;
+	trace_ms = trace_ms * (n_pre + n_wait +
+			       (n_trace + n_wait) * (n_repeat - 1)) + 50;
+	msleep(trace_ms);
+
+	f0 = 0;
+	for (i = 0; i < 50; i++) {
+		regmap_read(aw->regmap, AW8697_REG_GLB_STATE, &val);
+		if ((val & 0x0f) == 0) {
+			regmap_read(aw->regmap, AW8697_REG_F_LRA_F0_H, &val);
+			f0_reg = val << 8;
+			regmap_read(aw->regmap, AW8697_REG_F_LRA_F0_L, &val);
+			f0_reg |= val;
+			if (f0_reg)
+				f0 = 1000000000 / (f0_reg * AW8697_F0_COEFF);
+			break;
+		}
+		usleep_range(10000, 11000);
+	}
+
+	regmap_set_bits(aw->regmap, AW8697_REG_CONT_CTRL,
+			AW8697_CONT_CTRL_CLOSE_PLAYBACK);
+	regmap_clear_bits(aw->regmap, AW8697_REG_CONT_CTRL,
+			  AW8697_CONT_CTRL_F0_DETECT);
+
+	if (!f0) {
+		dev_warn(dev, "f0 measurement failed, using untrimmed oscillator\n");
+		goto out;
+	}
+
+	/* Out of the plausible range: trust the preset instead. */
+	f0_limit = f0;
+	if (f0 * 100 < aw->f0_pre * (100 - aw->f0_cali_percent) ||
+	    f0 * 100 > aw->f0_pre * (100 + aw->f0_cali_percent))
+		f0_limit = aw->f0_pre;
+
+	/* TRIM_LRA is 6-bit two's complement in steps of 0.25 %. */
+	step = 100000 * ((int)f0_limit - (int)aw->f0_pre) /
+	       ((int)f0_limit * 25);
+	if (step >= 0)
+		step = step / 10 + (step % 10 >= 5 ? 1 : 0);
+	else
+		step = step / 10 - (step % 10 <= -5 ? 1 : 0);
+	step = clamp(step, -32, 31);
+	aw->trim_lra = step & 0x3f;
+
+	dev_info(dev, "f0 %u.%u Hz (preset %u.%u Hz), trim 0x%02x\n",
+		 f0 / 10, f0 % 10, aw->f0_pre / 10, aw->f0_pre % 10,
+		 aw->trim_lra);
+
+out:
+	regmap_write(aw->regmap, AW8697_REG_TRIM_LRA, aw->trim_lra);
+	aw8697_stop(aw);
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			   AW8697_SYSCTRL_PLAY_MODE,
+			   AW8697_SYSCTRL_PLAY_MODE_RAM);
+}
+
+static int aw8697_load_ram(struct aw8697 *aw, const struct firmware *fw)
+{
+	struct device *dev = &aw->client->dev;
+	unsigned int base, fifo_ae, fifo_af;
+	u16 checksum = 0;
+	size_t i;
+	int ret;
+
+	if (fw->size <= AW8697_FW_HDR_LEN) {
+		dev_err(dev, "%s: too short (%zu bytes)\n", AW8697_FW_NAME,
+			fw->size);
+		return -EINVAL;
+	}
+
+	for (i = 2; i < fw->size; i++)
+		checksum += fw->data[i];
+	if (checksum != ((fw->data[0] << 8) | fw->data[1])) {
+		dev_err(dev, "%s: checksum mismatch\n", AW8697_FW_NAME);
+		return -EINVAL;
+	}
+
+	base = (fw->data[2] << 8) | fw->data[3];
+	fifo_ae = base >> 2;
+	fifo_af = base - (base >> 2);
+
+	regmap_set_bits(aw->regmap, AW8697_REG_SYSCTRL, AW8697_SYSCTRL_RAMINIT);
+
+	regmap_write(aw->regmap, AW8697_REG_BASE_ADDRH, base >> 8);
+	regmap_write(aw->regmap, AW8697_REG_BASE_ADDRL, base & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_FIFO_AEH, fifo_ae >> 8);
+	regmap_write(aw->regmap, AW8697_REG_FIFO_AEL, fifo_ae & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_FIFO_AFH, fifo_af >> 8);
+	regmap_write(aw->regmap, AW8697_REG_FIFO_AFL, fifo_af & 0xff);
+
+	regmap_write(aw->regmap, AW8697_REG_RAMADDRH, base >> 8);
+	regmap_write(aw->regmap, AW8697_REG_RAMADDRL, base & 0xff);
+	/* The SRAM address auto-increments on every RAMDATA write. */
+	for (i = AW8697_FW_HDR_LEN; i < fw->size; i++) {
+		ret = regmap_write(aw->regmap, AW8697_REG_RAMDATA,
+				   fw->data[i]);
+		if (ret)
+			break;
+	}
+
+	regmap_clear_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			  AW8697_SYSCTRL_RAMINIT);
+
+	if (ret) {
+		dev_err(dev, "failed to write waveform RAM: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(dev, "loaded %zu bytes of waveforms at 0x%04x\n",
+		 fw->size - AW8697_FW_HDR_LEN, base);
+	return 0;
+}
+
+static void aw8697_fw_loaded(const struct firmware *fw, void *context)
+{
+	struct aw8697 *aw = context;
+
+	if (!fw) {
+		dev_err(&aw->client->dev,
+			"%s not found, vibration disabled\n", AW8697_FW_NAME);
+		goto out;
+	}
+
+	mutex_lock(&aw->lock);
+	if (!aw8697_load_ram(aw, fw))
+		aw->ram_ready = true;
+	mutex_unlock(&aw->lock);
+
+	release_firmware(fw);
+out:
+	complete(&aw->fw_done);
+}
+
+static int aw8697_hw_init(struct aw8697 *aw)
+{
+	unsigned int val;
+
+	aw8697_set_active(aw, false);
+
+	regmap_update_bits(aw->regmap, AW8697_REG_PWMDBG,
+			   AW8697_PWMDBG_PWM_MODE, AW8697_PWMDBG_PWM_24K);
+
+	regmap_write(aw->regmap, AW8697_REG_BSTDBG1, aw8697_def_bstdbg[0]);
+	regmap_write(aw->regmap, AW8697_REG_BSTDBG2, aw8697_def_bstdbg[1]);
+	regmap_write(aw->regmap, AW8697_REG_BSTDBG3, aw8697_def_bstdbg[2]);
+	regmap_write(aw->regmap, AW8697_REG_TSET, AW8697_DEF_TSET);
+	regmap_write(aw->regmap, AW8697_REG_R_SPARE, AW8697_DEF_R_SPARE);
+
+	regmap_update_bits(aw->regmap, AW8697_REG_ANADBG, AW8697_ANADBG_IOC,
+			   AW8697_ANADBG_IOC_4P65A);
+	regmap_update_bits(aw->regmap, AW8697_REG_BSTCFG,
+			   AW8697_BSTCFG_PEAKCUR, AW8697_BSTCFG_PEAKCUR_3P5A);
+	regmap_update_bits(aw->regmap, AW8697_REG_BSTDBG4,
+			   AW8697_BSTDBG4_BSTVOL,
+			   FIELD_PREP(AW8697_BSTDBG4_BSTVOL, aw->bst_vol));
+
+	/* Motor protection off, manual boost: as downstream. */
+	regmap_set_bits(aw->regmap, AW8697_REG_DETCTRL,
+			AW8697_DETCTRL_PROTECT_NO_ACTION);
+	regmap_clear_bits(aw->regmap, AW8697_REG_PWMPRC, AW8697_PWMPRC_PRC_EN);
+	regmap_clear_bits(aw->regmap, AW8697_REG_PRLVL, AW8697_PRLVL_PR_EN);
+	regmap_clear_bits(aw->regmap, AW8697_REG_BST_AUTO,
+			  AW8697_BST_AUTO_AUTOSW);
+
+	/* Output offset calibration. */
+	regmap_set_bits(aw->regmap, AW8697_REG_SYSCTRL, AW8697_SYSCTRL_RAMINIT);
+	regmap_set_bits(aw->regmap, AW8697_REG_DETCTRL, AW8697_DETCTRL_DIAG_GO);
+	regmap_read_poll_timeout(aw->regmap, AW8697_REG_DETCTRL, val,
+				 !(val & AW8697_DETCTRL_DIAG_GO), 100, 50000);
+	regmap_clear_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			  AW8697_SYSCTRL_RAMINIT);
+
+	regmap_set_bits(aw->regmap, AW8697_REG_ADCTEST,
+			AW8697_ADCTEST_VBAT_HW_COMP);
+
+	aw8697_f0_calibrate(aw);
+
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHH_H, aw8697_def_bemf[0]);
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHH_L, aw8697_def_bemf[1]);
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHL_H, aw8697_def_bemf[2]);
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHL_L, aw8697_def_bemf[3]);
+
+	/* Edge-triggered interrupt line; no interrupt sources are used. */
+	regmap_set_bits(aw->regmap, AW8697_REG_DBGCTRL,
+			AW8697_DBGCTRL_INT_MODE_EDGE);
+
+	return 0;
+}
+
+static int aw8697_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct aw8697 *aw;
+	unsigned int id;
+	u32 val;
+	int ret, i;
+
+	aw = devm_kzalloc(dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	aw->client = client;
+	i2c_set_clientdata(client, aw);
+	mutex_init(&aw->lock);
+	INIT_WORK(&aw->play_work, aw8697_play_work);
+	init_completion(&aw->fw_done);
+
+	aw->f0_pre = AW8697_DEF_F0_PRE;
+	aw->f0_cali_percent = AW8697_DEF_F0_CALI_PERCENT;
+	aw->cont_drv_lvl = AW8697_DEF_CONT_DRV_LVL;
+	aw->bst_vol = AW8697_DEF_BST_VOL;
+
+	/* f0 in 0.1 Hz like the downstream vib_f0_pre property. */
+	if (!device_property_read_u32(dev, "awinic,f0-preset-decihertz", &val))
+		aw->f0_pre = val;
+	if (!device_property_read_u32(dev, "awinic,f0-tolerance-percent", &val))
+		aw->f0_cali_percent = val;
+	if (!aw->f0_pre)
+		return dev_err_probe(dev, -EINVAL, "invalid f0 preset\n");
+
+	aw->regmap = devm_regmap_init_i2c(client, &aw8697_regmap_config);
+	if (IS_ERR(aw->regmap))
+		return dev_err_probe(dev, PTR_ERR(aw->regmap),
+				     "failed to init regmap\n");
+
+	/* Asserted = low = chip held in reset. */
+	aw->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(aw->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	for (i = 0; i < 5; i++) {
+		gpiod_set_value_cansleep(aw->reset_gpio, 1);
+		usleep_range(5000, 6000);
+		gpiod_set_value_cansleep(aw->reset_gpio, 0);
+		usleep_range(5000, 6000);
+
+		ret = regmap_read(aw->regmap, AW8697_REG_ID, &id);
+		if (!ret && id == AW8697_CHIPID)
+			break;
+		usleep_range(2000, 3000);
+	}
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip id\n");
+	if (id != AW8697_CHIPID)
+		return dev_err_probe(dev, -ENODEV,
+				     "unexpected chip id 0x%02x\n", id);
+
+	regmap_write(aw->regmap, AW8697_REG_ID, AW8697_SOFT_RESET);
+	usleep_range(1000, 2000);
+
+	ret = aw8697_hw_init(aw);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to initialise chip\n");
+
+	aw->input = devm_input_allocate_device(dev);
+	if (!aw->input)
+		return -ENOMEM;
+
+	aw->input->name = "aw8697-haptics";
+	aw->input->id.bustype = BUS_I2C;
+	aw->input->close = aw8697_close;
+	input_set_drvdata(aw->input, aw);
+	input_set_capability(aw->input, EV_FF, FF_RUMBLE);
+
+	ret = input_ff_create_memless(aw->input, NULL, aw8697_play_effect);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to create FF device\n");
+
+	ret = input_register_device(aw->input);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register input\n");
+
+	/*
+	 * Writing the waveform RAM takes a few thousand I2C transactions;
+	 * do it asynchronously. Playback requests before it is done are
+	 * ignored.
+	 */
+	ret = request_firmware_nowait(THIS_MODULE, true, AW8697_FW_NAME, dev,
+				      GFP_KERNEL, aw, aw8697_fw_loaded);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request %s\n",
+				     AW8697_FW_NAME);
+
+	return 0;
+}
+
+static void aw8697_remove(struct i2c_client *client)
+{
+	struct aw8697 *aw = i2c_get_clientdata(client);
+
+	/* The firmware callback dereferences aw: let it finish first. */
+	wait_for_completion(&aw->fw_done);
+	cancel_work_sync(&aw->play_work);
+
+	mutex_lock(&aw->lock);
+	aw8697_stop(aw);
+	aw->ram_ready = false;
+	mutex_unlock(&aw->lock);
+}
+
+static int aw8697_suspend(struct device *dev)
+{
+	struct aw8697 *aw = dev_get_drvdata(dev);
+
+	cancel_work_sync(&aw->play_work);
+
+	mutex_lock(&aw->lock);
+	aw8697_stop(aw);
+	mutex_unlock(&aw->lock);
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(aw8697_pm_ops, aw8697_suspend, NULL);
+
+static const struct of_device_id aw8697_of_match[] = {
+	{ .compatible = "awinic,aw8697" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw8697_of_match);
+
+static const struct i2c_device_id aw8697_id[] = {
+	{ "aw8697" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, aw8697_id);
+
+static struct i2c_driver aw8697_driver = {
+	.driver = {
+		.name = "aw8697",
+		.of_match_table = aw8697_of_match,
+		.pm = pm_sleep_ptr(&aw8697_pm_ops),
+	},
+	.probe = aw8697_probe,
+	.remove = aw8697_remove,
+	.id_table = aw8697_id,
+};
+module_i2c_driver(aw8697_driver);
+
+MODULE_DESCRIPTION("Awinic AW8697 LRA haptic driver");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE(AW8697_FW_NAME);
