drm/panel: l3-42-02-0a: 10 bpc DSC, stock link rate and timing-switch tails.

Stock drives this panel with 10 bpc DSC (qcom,mdss-dsc-bit-per-component =
<10>; the panel's own 0x91 setup starts with 0xab = bpc 10 / line buffer 11),
as the in-tree NT37705 panels with the same 0x91 header do; we sent an 8 bpc
PPS. At 10 bpc msm derives a lower DSI clock from the mode, so htotal grows
from 1160 to 1252 to keep stock's 832 MHz link at 120 Hz (vrefresh unchanged,
command mode ignores porches otherwise).

Stock also ends every switch into 120 Hz with page 2 "cc 30; ce 01; 10 ms;
cc 00" and into 60 Hz with page 2 "cc 00"; without them the 60 Hz mode ran at
~29 Hz (TE measured as a 50 % square wave at 29.3 Hz).

diff --git a/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c b/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c
--- a/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c
+++ b/drivers/gpu/drm/panel/panel-l3-42-02-0a-dsc.c
@@ -103,6 +103,9 @@
 	case 60:
 		mipi_dsi_dcs_write_seq(dsi, 0x2f, 0x01);
 		mipi_dsi_dcs_write_seq(dsi, MIPI_DCS_SET_GAMMA_CURVE, 0x01);
+		/* stock timing-switch tail for 60 Hz */
+		mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x02);
+		mipi_dsi_dcs_write_seq(dsi, 0xcc, 0x00);
 		break;
 	case 90:
 		mipi_dsi_dcs_write_seq(dsi, 0x2f, 0x03);
@@ -121,6 +124,13 @@
 		mipi_dsi_dcs_write_seq(dsi, 0x6f, 0x09);
 		mipi_dsi_dcs_write_seq(dsi, 0xc0, 0x20);
 		mipi_dsi_dcs_write_seq(dsi, 0x2f, 0x02);
+		/* stock timing-switch tail for 120 Hz */
+		mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x02);
+		mipi_dsi_dcs_write_seq(dsi, 0xcc, 0x30);
+		mipi_dsi_dcs_write_seq(dsi, 0xce, 0x01);
+		msleep(10);
+		mipi_dsi_dcs_write_seq(dsi, 0xf0, 0x55, 0xaa, 0x52, 0x08, 0x02);
+		mipi_dsi_dcs_write_seq(dsi, 0xcc, 0x00);
 		break;
 	}
 	/* OSC calibration */
@@ -313,11 +323,11 @@
 }
 
 static struct drm_display_mode l3_42_02_0a_dsc_mode = {
-	.clock = (1080 + 32 + 16 + 32) * (2400 + 64 + 16 + 32) * 60 / 1000,
+	.clock = (1080 + 124 + 16 + 32) * (2400 + 64 + 16 + 32) * 60 / 1000,
 	.hdisplay = 1080,
-	.hsync_start = 1080 + 32,
-	.hsync_end = 1080 + 32 + 16,
-	.htotal = 1080 + 32 + 16 + 32,
+	.hsync_start = 1080 + 124,
+	.hsync_end = 1080 + 124 + 16,
+	.htotal = 1080 + 124 + 16 + 32,
 	.vdisplay = 2400,
 	.vsync_start = 2400 + 64,
 	.vsync_end = 2400 + 64 + 16,
@@ -331,7 +341,7 @@
 				     struct drm_connector *connector)
 {
 	/* same porches for every rate (stock timing@0/1/2), only the clock scales */
-	l3_42_02_0a_dsc_mode.clock = (1080 + 32 + 16 + 32) * (2400 + 64 + 16 + 32) *
+	l3_42_02_0a_dsc_mode.clock = (1080 + 124 + 16 + 32) * (2400 + 64 + 16 + 32) *
 				     l3_42_02_0a_dsc_rate() / 1000;
 
 	return drm_connector_helper_get_modes_fixed(connector, &l3_42_02_0a_dsc_mode);
@@ -447,7 +457,7 @@
 	 */
 	WARN_ON(1080 % ctx->dsc.slice_width);
 	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
-	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_component = 10;
 	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
 	ctx->dsc.block_pred_enable = true;
 
