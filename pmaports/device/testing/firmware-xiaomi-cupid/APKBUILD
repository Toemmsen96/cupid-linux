# Maintainer: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
# Proprietary firmware for the Xiaomi 12 (cupid).
#
# The remoteproc, GPU and IPA blobs come from the sm8450-mainline firmware
# repository. The upstream pmaports package fetches it from
# git.mainlining.org, which has been returning 502 for a long time; GitHub
# hosts the same repository and its archive contains the LFS-stored modem.mbn
# as a real file (verified: 108 MB ELF, same sha512 as the LFS object).
#
# The same repository carries aw8697_haptic.bin, the waveform library the
# AW8697 haptics driver (kernel patch 0019) writes into the chip RAM.
#
# The touchscreen firmware is not part of that repository. The ST FTS driver
# refuses to probe without it (FW_UPDATE_ON_PROBE returns -ENODEV), so it is
# fetched from the LineageOS vendor blob repository for cupid, pinned to a
# commit.
pkgname=firmware-xiaomi-cupid
pkgver=2
pkgrel=2
pkgdesc="Firmware for Xiaomi 12"
subpackages="
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-gpu
	$pkgname-haptics
	$pkgname-hexagonfs
	$pkgname-initramfs
	$pkgname-ipa
	$pkgname-modem
	$pkgname-slpi
	$pkgname-touchscreen
	"
url="https://github.com/sm8450-mainline/firmware-xiaomi-cupid"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="5da2787e4504ddb00107015432fd936156024ebc"
_muppets_commit="ba672d8f47c5533b2fb45bae5b4528594da70107"
_muppets="https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_xiaomi_cupid/$_muppets_commit/proprietary/vendor/firmware"
_muppets_sns="https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_xiaomi_cupid/$_muppets_commit/proprietary/vendor/etc/sensors"
# Sensor configs the SLPI reads through hexagonrpcd (see hexagonfs()).
_sns_configs="
