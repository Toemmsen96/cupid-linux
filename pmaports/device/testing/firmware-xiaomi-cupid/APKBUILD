# Maintainer: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
# Proprietary firmware for the Xiaomi 12 (cupid).
#
# The remoteproc, GPU and IPA blobs come from the sm8450-mainline firmware
# repository. The upstream pmaports package fetches it from
# git.mainlining.org, which has been returning 502 for a long time; GitHub
# hosts the same repository and its archive contains the LFS-stored modem.mbn
# as a real file (verified: 108 MB ELF, same sha512 as the LFS object).
#
# The same repository carries aw8697_haptic.bin, the waveform library the
# AW8697 haptics driver (kernel patch 0010) writes into the chip RAM.
#
# The touchscreen firmware is not part of that repository. The ST FTS driver
# refuses to probe without it (FW_UPDATE_ON_PROBE returns -ENODEV), so it is
# fetched from the LineageOS vendor blob repository for cupid, pinned to a
# commit.
pkgname=firmware-xiaomi-cupid
pkgver=2
pkgrel=1
pkgdesc="Firmware for Xiaomi 12"
subpackages="
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-gpu
	$pkgname-haptics
	$pkgname-initramfs
	$pkgname-ipa
	$pkgname-modem
	$pkgname-slpi
	$pkgname-touchscreen
	"
url="https://github.com/sm8450-mainline/firmware-xiaomi-cupid"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="5da2787e4504ddb00107015432fd936156024ebc"
_muppets_commit="ba672d8f47c5533b2fb45bae5b4528594da70107"
_muppets="https://raw.githubusercontent.com/TheMuppets/proprietary_vendor_xiaomi_cupid/$_muppets_commit/proprietary/vendor/firmware"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	30-initramfs-firmware.files
	st_fts_l3-$_muppets_commit.ftb::$_muppets/st_fts_l3.ftb
	st_fts_l3_thp-$_muppets_commit.ftb::$_muppets/st_fts_l3_thp.ftb
	stm_fts_production_limits-$_muppets_commit.csv::$_muppets/stm_fts_production_limits.csv
"
builddir="$srcdir/$pkgname-$_commit"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

adsp() {
	pkgdesc="Xiaomi 12 adsp firmware"

	install -Dm644 "$builddir"/adsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/cupid"
}

cdsp() {
	pkgdesc="Xiaomi 12 cdsp firmware"

	install -Dm644 "$builddir"/cdsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/cupid"
}

gpu() {
	pkgdesc="Xiaomi 12 gpu firmware"

	install -Dm644 "$builddir"/a730* -t \
		"$subpkgdir/lib/firmware/qcom/"
	install -Dm644 "$builddir"/gmu_gen7* -t \
		"$subpkgdir/lib/firmware/qcom/"
}

haptics() {
	pkgdesc="Xiaomi 12 haptics waveform library (Awinic AW8697)"

	# request_firmware() with the bare name, so top of /lib/firmware.
	install -Dm644 "$builddir"/aw8697_haptic.bin \
		"$subpkgdir"/lib/firmware/aw8697_haptic.bin
}

initramfs() {
	pkgdesc="Xiaomi 12 firmware to be included in the initramfs"

	# GPU firmware, plus st_fts_l3.ftb: the touch driver is loaded in the
	# initramfs (device package modules-initfs) so unl0kr can take input
	# for FDE, and it requests its firmware at probe without retrying
	# once the rootfs is mounted.

	install -Dm644 "$srcdir/30-initramfs-firmware.files" -t \
		"$subpkgdir"/usr/share/mkinitfs/files
}

ipa() {
	pkgdesc="Xiaomi 12 ipa firmware"

	install -Dm644 "$builddir"/ipa_fws.* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/cupid"
}

modem() {
	pkgdesc="Xiaomi 12 modem firmware"

	# cp because of the modem_pr directory
	mkdir -p "$subpkgdir/lib/firmware/qcom/sm8450/cupid"
	cp -r "$builddir"/modem* \
		"$subpkgdir/lib/firmware/qcom/sm8450/cupid"
	find "$subpkgdir/lib/firmware/qcom/sm8450/cupid" \
		-type f -exec chmod 0644 {} \;
}

slpi() {
	pkgdesc="Xiaomi 12 slpi firmware"

	install -Dm644 "$builddir"/slpi* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/cupid"
}

# NB: must not be called "-touch": abuild derives the shell function name from
# the suffix, and a touch() function shadows the touch(1) abuild itself uses.
touchscreen() {
	pkgdesc="Xiaomi 12 touchscreen firmware (ST FTS)"

	# The driver calls request_firmware() with the bare names from the
	# devicetree, so these go at the top of /lib/firmware.
	install -Dm644 "$srcdir"/st_fts_l3-$_muppets_commit.ftb \
		"$subpkgdir"/lib/firmware/st_fts_l3.ftb
	install -Dm644 "$srcdir"/st_fts_l3_thp-$_muppets_commit.ftb \
		"$subpkgdir"/lib/firmware/st_fts_l3_thp.ftb
	install -Dm644 "$srcdir"/stm_fts_production_limits-$_muppets_commit.csv \
		"$subpkgdir"/lib/firmware/stm_fts_production_limits.csv
}

