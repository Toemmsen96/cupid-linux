[Unit]
Description=Activate the modem carrier configuration (VoLTE) for the SIM
After=ModemManager.service tqftpserv.service
Wants=ModemManager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/cupid-modem-config
# A configuration active at power-on stalls the modem start-up.
ExecStop=/usr/libexec/cupid-modem-config stop
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
