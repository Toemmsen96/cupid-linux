# Maintainer: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-cupid
pkgdesc="Xiaomi 12"
pkgver=2
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	firmware-xiaomi-cupid-adsp
	firmware-xiaomi-cupid-cdsp
	firmware-xiaomi-cupid-gpu
	firmware-xiaomi-cupid-initramfs
	firmware-xiaomi-cupid-ipa
	firmware-xiaomi-cupid-modem
	firmware-xiaomi-cupid-slpi
	firmware-xiaomi-cupid-touchscreen
	linux-firmware-ath11k
	linux-firmware-qca
	linux-firmware-qcom
	make-dynpart-mappings
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
	soc-qcom-qbootctl
"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-kernel-stable:kernel_stable
	$pkgname-kernel-next:kernel_next
	$pkgname-phosh
	$pkgname-openrc
	$pkgname-systemd
"
source="
	deviceinfo
	modules-initfs
	cupid-modules.conf
	wifi-powersave-off.conf
	Xiaomi-12.conf
	HiFi.conf
	phoc.ini
	xiaomi,cupid.json
	50-cupid-gmobile.conf
	cupid-gmobile.sh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# The ST FTS touch driver is a module and the kernel never autoloads it
	# from the "st,spi" compatible on this image. Load it explicitly.
	install -Dm644 "$srcdir"/cupid-modules.conf \
		"$pkgdir"/etc/modules-load.d/cupid.conf

	# WiFi power save makes ath11k/WCN6855 time out hardware scans right
	# after associating. The PCIe ASPM half of the same problem is handled by
	# pcie_aspm.policy=performance on the kernel cmdline (deviceinfo).
	install -Dm644 "$srcdir"/wifi-powersave-off.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/wifi-powersave-off.conf

	# ALSA use case manager profile. Without one matching this card the
	# sound server cannot configure it and falls back to a dummy output.
	# alsa-lib looks this up as conf.d/<card driver>/<card name>.conf, which
	# for this device is sm8450/Xiaomi-12.
	install -Dm644 "$srcdir"/Xiaomi-12.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8450/Xiaomi-12.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/Cupid/HiFi.conf

	# ADSP topology: the sound card requests qcom/sm8450/Xiaomi-12-tplg.bin
	# and tears itself down without it. The SM8450 HDK topology from
	# linux-firmware is the one this ADSP firmware accepts. Both the plain
	# and the zstd name are linked so whichever linux-firmware ships works.
	mkdir -p "$pkgdir"/lib/firmware/qcom/sm8450
	ln -s SM8450-HDK-tplg.bin.zst \
		"$pkgdir"/lib/firmware/qcom/sm8450/Xiaomi-12-tplg.bin.zst
	ln -s SM8450-HDK-tplg.bin \
		"$pkgdir"/lib/firmware/qcom/sm8450/Xiaomi-12-tplg.bin
}

kernel_stable() {
	pkgdesc="sm8450-mainline 6.13-rc3 with the SM8450 bring-up fixes (recommended)"
	depends="linux-postmarketos-qcom-sm8450-cupid"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_next() {
	pkgdesc="sm8450-mainline next branch, 6.17-rc1 (experimental, untested on hardware)"
	depends="linux-postmarketos-qcom-sm8450-cupid-next"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

phosh() {
	install_if="$pkgname postmarketos-ui-phosh"

	# 1080x2400 at about 420 dpi: integer scale 2 gives 540x1200 logical
	# pixels, the size cupid has been run at before.
	install -Dm644 "$srcdir"/phoc.ini \
		"$subpkgdir"/etc/phosh/phoc.ini

	# Display cutout. gmobile only reads panel definitions from its
	# compiled-in GResource and upstream has no entry for cupid, so phosh
	# never learns this panel has a punch-hole. G_RESOURCE_OVERLAYS points
	# that one resource at the file below; no rebuild of gmobile needed.
	install -Dm644 "$srcdir"/xiaomi,cupid.json \
		"$subpkgdir"/usr/share/gmobile/devices/display-panels/xiaomi,cupid.json
	# systemd user sessions read environment.d, PAM/login shells read
	# profile.d. Ship both so either init system gets the overlay.
	install -Dm644 "$srcdir"/50-cupid-gmobile.conf \
		"$subpkgdir"/etc/environment.d/50-cupid-gmobile.conf
	install -Dm755 "$srcdir"/cupid-gmobile.sh \
		"$subpkgdir"/etc/profile.d/cupid-gmobile.sh
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="soc-qcom-openrc soc-qcom-qbootctl-openrc"

	mkdir -p "$subpkgdir"
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"

	mkdir -p "$subpkgdir"
}

