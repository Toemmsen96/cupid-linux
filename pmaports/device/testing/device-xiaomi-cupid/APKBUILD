build() {
	devicepkg_build $startdir $pkgname

	# ADSP topology: the HDK one with the speakers on tertiary TDM.
	m4 -I "$srcdir"/audioreach-topology-$_tplg_commit -I "$srcdir" \
		"$srcdir"/Xiaomi-12.m4 > "$srcdir"/Xiaomi-12-tplg.conf
	alsatplg -c "$srcdir"/Xiaomi-12-tplg.conf -o "$srcdir"/Xiaomi-12-tplg.bin
}

package() {
	devicepkg_package $startdir $pkgname

	# The ST FTS touch driver is a module and the kernel never autoloads it
	# from the "st,spi" compatible on this image. Load it explicitly.
	install -Dm644 "$srcdir"/cupid-modules.conf \
		"$pkgdir"/etc/modules-load.d/cupid.conf

	# Sensors (SLPI via hexagonrpcd + libssc): accelerometer orientation.
	install -Dm644 "$srcdir"/81-libssc-xiaomi-cupid.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-xiaomi-cupid.rules

	# Lets feedbackd (Phosh haptics) use the AW8697 vibration motor.
	install -Dm644 "$srcdir"/72-cupid-feedbackd.rules \
		"$pkgdir"/usr/lib/udev/rules.d/72-cupid-feedbackd.rules

	# WiFi power save makes ath11k/WCN6855 time out hardware scans right
	# after associating. The PCIe ASPM half of the same problem is handled by
	# pcie_aspm.policy=performance on the kernel cmdline (deviceinfo).
	install -Dm644 "$srcdir"/wifi-powersave-off.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/wifi-powersave-off.conf

	# ALSA use case manager profile. Without one matching this card the
	# sound server cannot configure it and falls back to a dummy output.
	# alsa-lib looks this up as conf.d/<card driver>/<card name>.conf, which
	# for this device is sm8450/Xiaomi-12.
	install -Dm644 "$srcdir"/Xiaomi-12.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8450/Xiaomi-12.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/Cupid/HiFi.conf
	install -Dm644 "$srcdir"/VoiceCall.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/Cupid/VoiceCall.conf

	# ADSP topology: the sound card requests qcom/sm8450/Xiaomi-12-tplg.bin
	# and tears itself down without it. Built from Xiaomi-12.m4: the SM8450
	# HDK topology with the speakers on the tertiary TDM interface.
	install -Dm644 "$srcdir"/Xiaomi-12-tplg.bin \
		"$pkgdir"/lib/firmware/qcom/sm8450/Xiaomi-12-tplg.bin
}

kernel_stable() {
	pkgdesc="sm8450-mainline 6.13-rc3 with the SM8450 bring-up fixes (recommended)"
	depends="linux-postmarketos-qcom-sm8450-cupid"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_next() {
	pkgdesc="sm8450-mainline next branch, 6.17-rc1 (experimental: display, ultra-wide camera)"
	depends="linux-postmarketos-qcom-sm8450-cupid-next"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_mainline() {
	pkgdesc="Linux 7.3 stable from kernel.org with the cupid patches (experimental)"
	depends="linux-postmarketos-qcom-sm8450-cupid-mainline"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

phosh() {
	install_if="$pkgname postmarketos-ui-phosh"

	# 1080x2400 at about 420 dpi: integer scale 2 gives 540x1200 logical
	# pixels, the size cupid has been run at before.
	install -Dm644 "$srcdir"/phoc.ini \
		"$subpkgdir"/etc/phosh/phoc.ini

	# Display cutout. gmobile only reads panel definitions from its
	# compiled-in GResource and upstream has no entry for cupid, so phosh
	# never learns this panel has a punch-hole. G_RESOURCE_OVERLAYS points
	# that one resource at the file below; no rebuild of gmobile needed.
	# abuild rejects "," in source names, so the source is xiaomi-cupid.json;
	# the installed name keeps gmobile's compatible-string naming.
	install -Dm644 "$srcdir"/xiaomi-cupid.json \
		"$subpkgdir"/usr/share/gmobile/devices/display-panels/xiaomi,cupid.json
	# systemd user sessions read environment.d, PAM/login shells read
	# profile.d. Ship both so either init system gets the overlay.
	install -Dm644 "$srcdir"/50-cupid-gmobile.conf \
		"$subpkgdir"/etc/environment.d/50-cupid-gmobile.conf
	install -Dm755 "$srcdir"/cupid-gmobile.sh \
		"$subpkgdir"/etc/profile.d/cupid-gmobile.sh
	# Keep Chatty out of the login screen session (SMS would land there).
	install -Dm644 "$srcdir"/chatty-not-in-greeter.conf \
		"$subpkgdir"/usr/lib/systemd/user/sm.puri.Chatty-daemon.service.d/50-not-in-greeter.conf
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="soc-qcom-openrc soc-qcom-qbootctl-openrc"

	mkdir -p "$subpkgdir"
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	# hexagonrpcd r100 (pmaports/temp) has the ADSP audio PD unit, which
	# loads the voice ECNS module; enabled by the preset.
	depends="hexagonrpcd-systemd>=0.4.0-r100 python3"

	# Copies this unit's sensor calibration from persist before
	# hexagonrpcd-sdsp starts; both enabled by the preset.
	install -Dm755 "$srcdir"/cupid-sensor-registry.sh \
		"$subpkgdir"/usr/libexec/cupid-sensor-registry
	install -Dm644 "$srcdir"/cupid-sensor-registry.service \
		"$subpkgdir"/usr/lib/systemd/system/cupid-sensor-registry.service
	# Activates the SIM's carrier configuration (VoLTE) in the modem;
	# enabled by the preset.
	install -Dm755 "$srcdir"/cupid-modem-config.py \
		"$subpkgdir"/usr/libexec/cupid-modem-config
	install -Dm644 "$srcdir"/cupid-modem-config.service \
		"$subpkgdir"/usr/lib/systemd/system/cupid-modem-config.service
	# Generates the voice call firmware (kernel 0042) from the stock ACDB on
	# the vendor partition at boot; enabled by the preset. The tools are
	# scripts/voicecall and scripts/acdb of cupid-linux, laid out the same
	# way (voicecall.py finds acdb/ next to its own directory).
	install -Dm755 "$srcdir"/cupid-voice-firmware.sh \
		"$subpkgdir"/usr/libexec/cupid-voice-firmware
	install -Dm644 "$srcdir"/cupid-voice-firmware.service \
		"$subpkgdir"/usr/lib/systemd/system/cupid-voice-firmware.service
	install -Dm644 "$srcdir"/voicecall.py \
		"$subpkgdir"/usr/share/cupid-voicecall/voicecall/voicecall.py
	local f
	for f in acdb.py vcpm_cal.py names.json; do
		install -Dm644 "$srcdir"/$f \
			"$subpkgdir"/usr/share/cupid-voicecall/acdb/$f
	done
	install -Dm644 "$srcdir"/90-device-xiaomi-cupid.preset \
		"$subpkgdir"/usr/lib/systemd/system-preset/90-device-xiaomi-cupid.preset
}

