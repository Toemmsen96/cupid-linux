# Contributor: Clayton Craft <clayton@craftyguy.net>
# Maintainer: Clayton Craft <clayton@craftyguy.net>
pkgname=usb-moded-notify
pkgver=0.4.2
pkgrel=100
# cupid-linux overlay of Alpine's community/usb-moded-notify 0.4.2-r2: 0001
# shows the USB mode notification at login only when a cable is plugged in
# (it appeared after every login). The tarball comes from Alpine's distfiles
# mirror (same sha512 as Alpine's), as upstream's GitLab was unreachable.
pkgdesc="Simple daemon for handling usb-moded dialog events with notifications"
url="https://gitlab.nura.eco/nura/usb-moded-notify"
arch="noarch"
license="GPL-3.0-or-later"
depends="
	py3-dbus
	py3-gobject3
	python3
	"
makedepends="just"
subpackages="$pkgname-openrc $pkgname-systemd"
source="https://distfiles.alpinelinux.org/distfiles/edge/usb-moded-notify-$pkgver.tar.gz
	0001-show-the-mode-at-login-only-when-a-cable-is-plugged.patch
	"
options="!check" # no tests

package() {
	PREFIX=/usr DESTDIR="$pkgdir" just install
}

sha512sums="
