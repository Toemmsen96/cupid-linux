e8c43cbbbbcfb3cb74411d3de44d52fa6ef04ef7d4f1fe7a271dafe50ebde3778ff7705d0c2fce677149ea6570cd347dd0e4520240a64bfe71bf1d175d0a51ba  0001-show-the-mode-at-login-only-when-a-cable-is-plugged.patch
"
