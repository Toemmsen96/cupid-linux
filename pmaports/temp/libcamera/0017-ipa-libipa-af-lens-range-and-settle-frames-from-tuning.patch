 #include <linux/v4l2-controls.h>
 
 #include <libcamera/base/log.h>
@@ -14,6 +16,8 @@
 #include <libcamera/control_ids.h>
 #include <libcamera/controls.h>
 
+#include "libcamera/internal/value_node.h"
+
 namespace libcamera {
 
 namespace ipa {
@@ -40,6 +44,7 @@ class AfAlgorithm
 public:
 	AfAlgorithm();
 
+	int init(const ValueNode &tuningData);
 	void configure(af::ActiveState &state, const ControlInfoMap &lensControls);
 	void process(af::ActiveState &state, double variance);
 	bool coarseCompleted() { return coarseCompleted_; }
@@ -68,6 +73,16 @@ private:
 	uint32_t maxStep_;
 	/* Initial value of maxStep_ */
 	uint32_t initMaxStep_;
+	/* The lowest lens position scanned. */
+	uint32_t minStep_ = 0;
+	/* Lens range from the tuning file, if set. */
+	std::optional<uint32_t> lensMin_;
+	std::optional<uint32_t> lensMax_;
+	/* Fine scan step from the tuning file, if set. */
+	std::optional<uint32_t> fineStepTuning_;
+	/* Frames whose statistics are skipped after each lens move. */
+	uint32_t settleFrames_ = 0;
+	uint32_t settleCounter_ = 0;
 	uint32_t coarseStep_ = 30;
 	uint32_t fineStep_ = 1;
 	/* If the coarse scan completes, it is set to true. */
diff --git a/src/ipa/softisp/algorithms/af.cpp b/src/ipa/softisp/algorithms/af.cpp
index 83eb545..b518b0b 100644
--- a/src/ipa/softisp/algorithms/af.cpp
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -35,6 +35,11 @@ static constexpr double kMinLevel = 4.0;
 /* Scale applied to the normalised contrast, so that the values are readable. */
 static constexpr double kContrastScale = 1e6;
 
+int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	return afAlgo_.init(tuningData);
+}
