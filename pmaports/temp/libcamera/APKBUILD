# Forked from Alpine for temporary downstream patches
# cupid-linux: postmarketOS temp/libcamera (pmaports main, 2026-11-16) plus
# 0003, sensor helpers/properties for the Xiaomi 12 cameras (pkgrel 2), and
# 0004-0015, software ISP autofocus: Milan Zamazal's "Autofocus basics for
# software ISP" v2 plus focus statistics, as in
# github.com/jaydens-tasty-slop/libcamera gts3/af-stats (pkgrel 3);
# 0016 scales the AF search steps to the lens range (12-bit VCM, pkgrel 4);
# ov32b40/imx766/s5k5e9.yaml: colour matrices and lens shading from the stock
# Chromatix tuning, generated by scripts/camx-tuning.py (pkgrel 6);
# 0017 takes the AF lens range and settle frames from the tuning file, set
# for the IMX766 in imx766.yaml; the yaml files also get Bayesian AWB
# along the stock AWB white points (pkgrel 7); ov13b10.yaml, the ultra-wide,
# from its stock tuning the same way (pkgrel 8).
maintainer="Robert Mader <robert.mader@collabora.com>"
pkgname=libcamera
_pkgver=0.8.0
pkgver=9999$_pkgver
pkgrel=8
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="all"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	doxygen
	eudev-dev
	glib-dev
	gnutls-dev
	graphviz
	gst-plugins-base-dev
	gtest-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	libyuv-dev
	linux-headers
	meson
	py3-jinja2
	py3-ply
	py3-pybind11-dev
	py3-sphinx
	py3-sphinxcontrib-doxylink
	py3-yaml
	python3-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-gstreamer
	$pkgname-ipa
	$pkgname-tools
	$pkgname-v4l2
	py3-$pkgname-pyc:pyc
	py3-$pkgname:py3
	qcam
	"
_tuning_files="
	hi846.yaml
	imx355.yaml
	imx363.yaml
	imx371.yaml
	imx376.yaml
	imx519.yaml
	imx800.yaml
	imx858.yaml
	s5k3l6xx.yaml
	s5kjn1.yaml
	ov32b40.yaml
	imx766.yaml
	s5k5e9.yaml
	ov13b10.yaml
	"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_pkgver/libcamera-v$_pkgver.tar.gz
	0001-libcamera-software_isp-Allow-limiting-output-sizes.patch
	0002-libcamera-Add-quad-Bayer-CFA-layout-support.patch
	0003-libcamera-add-the-xiaomi-12-camera-sensors.patch
	0004-libcamera-software_isp-Let-a-single-point-decide-abo.patch
	0005-ipa-ipu3-Move-non-specific-parts-of-Af-to-libipa.patch
	0006-ipa-libipa-Add-af-prepareControls.patch
	0007-libcamera-software_isp-Add-variance-to-stats.patch
	0008-ipa-softisp-Remove-unused-imports-from-ipa_context.h.patch
	0009-ipa-softisp-Add-Af-algorithm.patch
	0010-libcamera-software_isp-Add-autofocus-controls.patch
	0011-ipa-libipa-Use-autofocus-limits-if-available.patch
	0012-libcamera-software_isp-Gather-focus-statistics.patch
	0013-ipa-softisp-af-Measure-the-focus-with-the-focus-stat.patch
	0014-ipa-softisp-af-Report-the-focus-figure-of-merit-also.patch
	0015-ipa-softisp-Enable-the-Af-algorithm-in-the-uncalibra.patch
	0016-ipa-libipa-af-scale-the-search-steps-to-the-lens-range.patch
	0017-ipa-libipa-af-lens-range-and-settle-frames-from-tuning.patch
	qcam.desktop
	$_tuning_files
	"
builddir="$srcdir/$pkgname-v$_pkgver"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
arm*|aarch64)
	# must be ordered before the ipa subpackage
	subpackages="$pkgname-raspberrypi $subpackages"
	;;
esac

build() {
	abuild-meson \
		-Dv4l2=true \
		-Dwerror=false \
		-Ddocumentation=disabled \
		. output
	meson compile -C output
}

check() {
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 -t "$pkgdir"/usr/share/applications "$srcdir"/qcam.desktop

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends="$pkgname=$pkgver-r$pkgrel"
	install_if="$pkgname=$pkgver-r$pkgrel"

	amove usr/lib/libcamera/ipa
	amove usr/share/libcamera/ipa

	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done

	for _tuning_file in $_tuning_files; do
		install -Dm644 -t "$subpkgdir"/usr/share/libcamera/ipa/softisp \
			"$srcdir"/"$_tuning_file"
	done
}

qcam() {
	depends=""
	amove usr/bin/qcam

	amove usr/share/applications/qcam.desktop
}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
	amove usr/bin/lc-compliance
}

py3() {
	pkgdesc="$pkgname (python bindings)"
	depends="python3"

	amove usr/lib/python*
}


