From: Toemmsen96 <147745097+Toemmsen96@users.noreply.github.com>
Subject: [PATCH] rpcd: create the static audio PD (-a)

The ADSP's audio PD is a static PD: FASTRPC_IOCTL_INIT_CREATE_STATIC with
the name "audiopd" creates it and hands the DSP the remote heap the kernel
reserves for it (memory-region of the ADSP fastrpc node). The audio
framework there loads dynamic modules (e.g. the voice echo canceller)
from the DSP partition through this server, as audioadsprpcd does on
Android.
---
diff --git a/hexagonrpcd/hexagonrpcd.1 b/hexagonrpcd/hexagonrpcd.1
index 54c77bb..d95816c 100644
--- a/hexagonrpcd/hexagonrpcd.1
+++ b/hexagonrpcd/hexagonrpcd.1
@@ -9,6 +9,10 @@ Server for FastRPC remote procedure calls from Qualcomm DSPs\&.
 .PP
 .SH OPTIONS
 .TP
+\fB\-a\fP
+Create the static audio pd (audiopd) on the ADSP. The kernel needs a
+remote heap for it (memory-region of the ADSP fastrpc node).
+.TP
 \fB\-c \fISHELL\fP
 Create a new pd running the specified ELF
 \fB\-d \fIDSP\fP
diff --git a/hexagonrpcd/rpcd.c b/hexagonrpcd/rpcd.c
index cc1f5cf..c674abf 100644
--- a/hexagonrpcd/rpcd.c
+++ b/hexagonrpcd/rpcd.c
@@ -135,6 +135,7 @@ static void print_usage(const char *argv0)
 	printf("Usage: %s [options] -f DEVICE\n\n", argv0);
 	printf("Server for FastRPC remote procedure calls from Qualcomm DSPs\n\n"
 	       "Options:\n"
+	       "\t-a\t\tCreate the static audio pd (audiopd)\n"
 	       "\t-c SHELL\t\tCreate a new pd running the specified ELF\n"
 	       "\t-d DSP\t\tDSP name (default: "")\n"
 	       "\t-f DEVICE\tFastRPC device node to attach to\n"
@@ -143,6 +144,23 @@ static void print_usage(const char *argv0)
 	       "\t-s\t\tAttach to sensorspd\n");
 }
 
+/*
+ * The audio PD is a static PD on the ADSP. Creating it hands the DSP the
+ * remote heap the kernel reserves for it (memory-region of the ADSP
+ * fastrpc node); the PD then loads dynamic modules through this server.
+ */
+static int create_audio_pd(int fd)
+{
+	static const char name[] = "audiopd";
+	struct fastrpc_init_create_static init = {
+		.namelen = sizeof(name),
+		.memlen = 0,
+		.name = (__u64) (uintptr_t) name,
+	};
+
+	return ioctl(fd, FASTRPC_IOCTL_INIT_CREATE_STATIC, &init);
+}
+
 static int create_shell_pd(int fd, const char *create_shell)
 {
 	char *buf;
@@ -418,6 +436,7 @@ int main(int argc, char* argv[])
 	size_t n_progs = 0;
 	int fd, ret, opt;
 	bool attach_sns = false;
+	bool audio_pd = false;
 
 	progs = malloc(sizeof(const char *) * argc);
 	if (progs == NULL) {
@@ -435,8 +454,11 @@ int main(int argc, char* argv[])
 	if (guessed_device_dir != NULL)
 		device_dir = guessed_device_dir;
 
-	while ((opt = getopt(argc, argv, "c:d:f:p:R:s")) != -1) {
+	while ((opt = getopt(argc, argv, "ac:d:f:p:R:s")) != -1) {
 		switch (opt) {
+			case 'a':
+				audio_pd = true;
+				break;
 			case 'c':
 				create_shell = optarg;
 				break;
@@ -467,7 +489,9 @@ int main(int argc, char* argv[])
 		goto err_free_pids;
 	}
 
-	printf("Starting %s (%s) on %s\n", argv[0], attach_sns? "INIT_ATTACH_SNS": "INIT_ATTACH", fastrpc_node);
+	printf("Starting %s (%s) on %s\n", argv[0],
+	       audio_pd? "INIT_CREATE_STATIC audiopd":
+	       attach_sns? "INIT_ATTACH_SNS": "INIT_ATTACH", fastrpc_node);
 
 	fd = open(fastrpc_node, O_RDWR);
 	if (fd < 0) {
@@ -475,7 +499,9 @@ int main(int argc, char* argv[])
 		goto err_free_pids;
 	}
 
-	if (attach_sns)
+	if (audio_pd)
+		ret = create_audio_pd(fd);
+	else if (attach_sns)
 		ret = ioctl(fd, FASTRPC_IOCTL_INIT_ATTACH_SNS, NULL);
 	else if (create_shell != NULL)
 		ret = create_shell_pd(fd, create_shell);
