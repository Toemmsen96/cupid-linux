pkgname=phosh-plugin-mic-status-icon
pkgver=0.1
pkgrel=1
# cupid-linux package, not an overlay: a phosh status icon shown while an
# application records audio, like phosh 0.59's camera indicator. Built out
# of tree; phosh's release tarball only provides status-icon.h. Watches
# PulseAudio source outputs (PulseAudio or pipewire-pulse), as GNOME Shell.
_phoshver=0.59.0
pkgdesc="Phosh status icon shown while the microphone is in use"
url="https://gitlab.gnome.org/World/Phosh/phosh"
arch="all !armhf"
license="GPL-3.0-or-later"
depends="phosh"
install_if="phosh"
makedepends="gtk+3.0-dev pulseaudio-dev"
source="https://sources.phosh.mobi/releases/phosh/phosh-$_phoshver.tar.xz
	mic-status-icon.c
	mic-status-icon.plugin
	50_phosh-mic-status-icon.gschema.override
	"
builddir="$srcdir"
options="!check" # no tests; checked on the phone

build() {
	# phosh resolves phosh_status_icon_get_type when it loads the module.
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS -fPIC -shared -Wall -Wextra -Wno-unused-parameter \
		-I"$srcdir/phosh-$_phoshver/src" \
		$(pkg-config --cflags gtk+-3.0 libpulse-mainloop-glib) \
		-o libphosh-plugin-mic-status-icon.so "$srcdir"/mic-status-icon.c \
		$LDFLAGS $(pkg-config --libs gtk+-3.0 libpulse-mainloop-glib)
}

package() {
	install -Dm755 libphosh-plugin-mic-status-icon.so \
		-t "$pkgdir"/usr/lib/phosh/plugins/
	install -Dm644 "$srcdir"/mic-status-icon.plugin \
		-t "$pkgdir"/usr/lib/phosh/plugins/
	install -Dm644 "$srcdir"/50_phosh-mic-status-icon.gschema.override \
		-t "$pkgdir"/usr/share/glib-2.0/schemas/
}

