# Personal settings for the cupid-linux scripts. Copy to cupid.env (which is
# gitignored) and fill in; scripts/env.sh reads it. Keep personal data
# (names, addresses, numbers, passwords, carrier) out of tracked files and
# put it here instead.

# SSH target of the running phone (scripts/phone-build.sh, local-pull.sh).
CUPID_PHONE=user@192.0.2.10

# User password for new images (scripts/build.sh; without it pmbootstrap
# asks, arch/build-arch-rootfs.sh requires it).
#CUPID_PASSWORD=

# Number to send test SMS to and call (modem/call-audio tests).
#CUPID_TEST_NUMBER=+41000000000

# Build settings from scripts/env.sh can go here too, e.g.:
#CUPID_KERNEL=mainline
#CUPID_UI=phosh
